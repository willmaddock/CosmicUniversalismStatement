    };
    document.querySelectorAll<HTMLButtonElement>('[data-details-toggle]').forEach((button) => button.addEventListener('click', () => { const details = document.querySelector<HTMLElement>(`#${button.getAttribute('aria-controls')}`); if (!details) return; const open = details.hidden; details.hidden = !open; button.setAttribute('aria-expanded', String(open)); button.textContent = open ? 'Hide Configuration Details' : 'Show Configuration Details'; }));
    document.querySelectorAll<HTMLButtonElement>('.proven-configuration-generate').forEach((button) => button.addEventListener('click', () => { const preset = provenConfigurationPresets.find((candidate) => candidate.id === button.dataset.provenPreset); if (!preset || !confirmPresetClear()) return; validateAndGenerate(preset); }));
    document.querySelectorAll<HTMLButtonElement>('.proven-configuration-customize').forEach((button) => button.addEventListener('click', () => { const preset = provenConfigurationPresets.find((candidate) => candidate.id === button.dataset.provenPreset); if (preset && confirmPresetClear()) applyForCustomization(preset); }));
    form.addEventListener('change', (event) => { showConditional(); if ((event.target as HTMLElement).closest('select, input, textarea')) markCustomized(); });
