      const invalidPresetFields = applyPreset(preset);
      if (invalidPresetFields.length) { renderErrors([`The ${preset.name} preset contains an unavailable or empty value: ${invalidPresetFields.join(', ')}.`]); setOutputAvailable(false); focusInvalid(invalidPresetFields); return; }
