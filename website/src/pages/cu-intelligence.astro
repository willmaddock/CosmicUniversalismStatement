    addMenuItem?.addEventListener('click', () => { readItems(); if (items.length >= 12) { menuStatus!.textContent = 'Maximum of 12 menu choices reached'; return; } items.push(menuItem('', '')); renderMenu(); menuStatus!.textContent = items.length >= 12 ? 'Maximum of 12 menu choices reached' : 'Menu choice added.'; });
