---
import ContentSection from '../components/ContentSection.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
---

<ContentPageLayout
  metaTitle="Media | Cosmic Universalism"
  metaDescription="An introduction to future Cosmic Universalism media and explanatory resources."
  eyebrow="Media"
  title="Different ways into a large framework"
  description="The media library will gather accessible explanations, visual narratives, and conversations about Cosmic Universalism."
>
  <ContentSection id="media-clarity" title="Clarity before volume" variant="panel">
    <p>
      Future media will identify whether it explains source science, CU mathematics,
      a theoretical proposition, or an open question. This foundation keeps those
      categories visible before the library grows.
    </p>
  </ContentSection>
</ContentPageLayout>
