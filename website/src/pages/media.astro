---
import ContinuationNavigation from '../components/page-system/ContinuationNavigation.astro';
import EditorialSectionHeading from '../components/page-system/EditorialSectionHeading.astro';
import EpistemicCallout from '../components/page-system/EpistemicCallout.astro';
import MediaCard from '../components/media/MediaCard.astro';
import { mediaLibrary } from '../data/media/media-library';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
---

<ContentPageLayout
  metaTitle="Media | Cosmic Universalism"
  metaDescription="Owner-curated Cosmic Universalism media with explicit classifications, source boundaries, transcripts, and permanent CU context."
  eyebrow="Media"
  title="Different ways into a large framework"
  description="The CU Media library pairs accessible explanations with owner-reviewed classifications, source boundaries, transcripts, and permanent interpretive context."
>
  <section
    id="media-clarity"
    class="media-foundation"
    aria-labelledby="media-clarity-title"
  >
    <EditorialSectionHeading
      eyebrow="Foundation"
      title="Clarity before volume"
      headingId="media-clarity-title"
    />

    <div class="media-foundation__body">
      <EpistemicCallout kind="method" label="Deliberate publication">
        <p>
          Every Media entry identifies whether it presents empirical references, CU
          mathematics, theoretical propositions, philosophical interpretation, or open
          questions. YouTube delivers video; the CU website retains the owner-reviewed
          publication record and context.
        </p>
      </EpistemicCallout>
    </div>
  </section>

  <section
    id="media-library"
    class="media-library"
    aria-labelledby="media-library-title"
  >
    <EditorialSectionHeading
      eyebrow="Owner-curated library"
      title="Owner-reviewed Media publications"
      headingId="media-library-title"
      lead="These owner-reviewed publications are part of the Cosmic Universalism Media library. Each entry links to a permanent CU detail page with classification, transcript, accessibility resources, source provenance, and publication boundaries."
    />

    <div class="media-library__grid">
      {mediaLibrary.map((entry) => <MediaCard entry={entry} />)}
    </div>
  </section>

  <section
    id="media-publication-standard"
    class="media-standard"
    aria-labelledby="media-publication-standard-title"
  >
    <EditorialSectionHeading
      eyebrow="Editorial boundary"
      title="Publication standard"
      headingId="media-publication-standard-title"
    />

    <div class="media-standard__body">
      <p>
        Established scientific material is sourced separately from CU interpretation.
        CU mathematics and theoretical propositions retain their canonical classifications,
        and unresolved issues remain visibly labeled as open questions.
      </p>
      <EpistemicCallout kind="boundary" label="Publication remains deliberate">
        <p>
          These entries were published through an owner-controlled release. Public
          availability does not change their classification, provenance, accessibility,
          or epistemic boundaries.
        </p>
      </EpistemicCallout>
    </div>
  </section>

  <ContinuationNavigation
    ariaLabel="Continue from Media"
    title="Continue to About"
    description="Learn about the project, its authorship, and its public commitments"
    path="about/"
  />
</ContentPageLayout>

<style>
  .media-foundation {
    padding: clamp(var(--space-6), 5vw, var(--space-12));
    border: 1px solid var(--color-border-feature);
    background:
      linear-gradient(
        145deg,
        var(--color-panel-feature),
        var(--color-background)
      );
  }

  .media-foundation__body {
    margin-top: var(--space-8);
  }

  .media-foundation :global(.epistemic-callout) {
    max-width: none;
  }

  .media-library,
  .media-standard {
    margin-top: var(--space-editorial-section);
  }

  .media-library__grid {
    display: grid;
    margin-top: var(--space-8);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .media-standard {
    padding: clamp(var(--space-6), 5vw, var(--space-10));
    border: 1px solid var(--color-border-quiet);
    background: var(--color-panel-quiet);
  }

  .media-standard__body {
    max-width: var(--measure-readable);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .media-standard__body > p {
    margin: 0;
  }

  .media-standard__body :global(.epistemic-callout) {
    margin-top: var(--space-6);
  }

  @media (max-width: 48rem) {
    .media-library__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 36rem) {
    .media-foundation,
    .media-standard {
      padding: var(--space-4);
    }

    .media-foundation__body,
    .media-standard__body,
    .media-library__grid {
      margin-top: var(--space-4);
    }
  }
</style>
