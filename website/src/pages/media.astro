---
import Header from '../components/Header.astro';
import PageIntroduction from '../components/PageIntroduction.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Media | Cosmic Universalism"
  description="An introduction to future Cosmic Universalism media and explanatory resources."
>
  <Header slot="header" />
  <PageIntroduction
    eyebrow="Media"
    title="Different ways into a large framework"
    description="The media library will gather accessible explanations, visual narratives, and conversations about Cosmic Universalism."
  >
    <div class="media-introduction">
      <h2>Clarity before volume</h2>
      <p>
        Future media will identify whether it explains source science, CU mathematics,
        a theoretical proposition, or an open question. This foundation keeps those
        categories visible before the library grows.
      </p>
    </div>
  </PageIntroduction>
</BaseLayout>

<style>
  .media-introduction {
    max-width: var(--measure-readable);
    padding: var(--space-8);
    border: 1px solid var(--color-translucent-blue);
    background: var(--color-surface-translucent);
  }

  h2 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.5rem); }
  p { margin-block: var(--space-4) 0; }

  @media (max-width: 36rem) {
    .media-introduction { padding: var(--space-6); }
  }
</style>
