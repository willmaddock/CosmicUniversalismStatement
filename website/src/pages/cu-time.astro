---
import ClassificationBadge from '../components/ClassificationBadge.astro';
import ContentSection from '../components/ContentSection.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import CUTimeConverter from '../components/CUTimeConverter.astro';
---

<ContentPageLayout
  metaTitle="CU-Time | Cosmic Universalism"
  metaDescription="An introduction to CU-Time as a proposed deep-time coordinate system."
  eyebrow="CU-Time"
  title="A coordinate system for the Cosmic Breath"
  description="CU-Time is the framework’s proposed notation for locating dates and events within its deep-time model."
>
  <ContentSection
    id="cu-time-context"
    title="About this converter"
    variant="notice"
  >
    <p>
      CU-Time connects familiar chronology with the framework’s larger sequence of
      cosmic phases. The converter below translates a converter-aligned CU-Time value
      into a corresponding proleptic Gregorian date and UTC time.
    </p>

    <p>
      This tool implements the documented mathematical constants and calendar rules.
      It does not generate phase classifications or empirical cosmology claims.
    </p>
  </ContentSection>

  <div class="cu-time-details">
    <ContentSection id="cu-time-purpose-limits" title="Purpose and limits">
      <ClassificationBadge
        slot="context"
        classification="cu-mathematical-model"
      />

      <p>
        CU-Time is intended to provide consistent notation for positions within the
        Cosmic Breath framework. It is a CU-specific mathematical construction, and its
        usefulness depends on clearly documented definitions, assumptions, and conversion
        rules.
      </p>
    </ContentSection>

    <ContentSection id="cu-time-documentation" title="Conversion boundaries">
      <p>
        Inputs use plain decimal notation. Results use UTC, a proleptic Gregorian calendar,
        and civil CE/BCE years without a public year zero. The original reference converter
        remains unchanged as historical implementation evidence.
      </p>
    </ContentSection>
  </div>

  <CUTimeConverter />
</ContentPageLayout>

<style>
  .cu-time-details {
    display: grid;
    margin-top: var(--space-12);
    gap: var(--space-12);
  }
</style>
