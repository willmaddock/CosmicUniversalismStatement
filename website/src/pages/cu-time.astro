---
import ClassificationBadge from '../components/ClassificationBadge.astro';
import ContentSection from '../components/ContentSection.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import CUTimeConverter from '../components/CUTimeConverter.astro';
---

<ContentPageLayout
  metaTitle="CU-Time | Cosmic Universalism"
  metaDescription="An introduction to CU-Time as a proposed deep-time coordinate system."
  eyebrow="CU-Time"
  title="A coordinate system for the Cosmic Breath"
  description="CU-Time is the framework’s proposed notation for locating dates and events within its deep-time model."
>
  <ContentSection
    id="cu-time-context"
    title="This page establishes context only"
    variant="notice"
  >
    <p>
      CU-Time connects familiar chronology with the framework’s larger sequence of
      cosmic phases. Its calculations and conversion methods are not reproduced or
      modified in this phase of the website.
    </p>

    <p>
      Future documentation can explain inputs, outputs, calibration, uncertainty,
      and mathematical assumptions before any interactive converter is introduced.
    </p>
  </ContentSection>

  <div class="cu-time-details">
    <ContentSection id="cu-time-purpose-limits" title="Purpose and limits">
      <ClassificationBadge
        slot="context"
        classification="cu-mathematical-model"
      />

      <p>
        CU-Time is intended to provide consistent notation for positions within the
        Cosmic Breath framework. It is a CU-specific mathematical construction, and its
        usefulness depends on clearly documented definitions, assumptions, and conversion
        rules.
      </p>
    </ContentSection>

    <ContentSection id="cu-time-documentation" title="Documentation before conversion">
      <p>
        Before an interactive converter is introduced, its inputs, outputs, calibration,
        uncertainty, and relationship to conventional chronology should be documented for
        review. Until then, this page should remain explanatory rather than calculational.
      </p>
    </ContentSection>
  </div>

  <CUTimeConverter />
</ContentPageLayout>

<style>
  .cu-time-details {
    display: grid;
    margin-top: var(--space-12);
    gap: var(--space-12);
  }
</style>