---
import ClassificationBadge from '../components/ClassificationBadge.astro';
import CosmicBreathCycleExplorer from '../components/CosmicBreathCycleExplorer.astro';
import CosmicBreathEducation from '../components/CosmicBreathEducation.astro';
import CosmicBreathEmpiricalScience from '../components/CosmicBreathEmpiricalScience.astro';
import CosmicBreathPageGuide from '../components/CosmicBreathPageGuide.astro';
import CosmicBreathTheoryAndMethod from '../components/CosmicBreathTheoryAndMethod.astro';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
---

<ContentPageLayout
  metaTitle="Cosmic Breath | Cosmic Universalism"
  metaDescription="An introduction to the Cosmic Breath and its distinct structural scales."
  eyebrow="Cosmic Breath"
  title="A proposed cycle of expansion and compression"
  description="The Cosmic Breath is CU’s organizing model for a 3.108 trillion-year cycle: 2.8 trillion years of expansion followed by 308 billion years of compression."
>
  <span id="cosmic-breath-page-top" class="page-top-sentinel" aria-hidden="true"></span>
  <section
    id="cosmic-breath-structure"
    class="breath-overview"
    aria-labelledby="cosmic-breath-structure-title"
  >
    <div class="breath-overview__diagram">
      <CosmicBreathCycleExplorer />
    </div>
    <div class="breath-overview__content">
      <h2 id="cosmic-breath-structure-title">Structural scales remain distinct</h2>
      <p>
        The framework uses named tom scales as separate structural positions. In
        particular, <strong>sub-ctom</strong> is not interchangeable with
        <strong>ctom</strong>.
      </p>
      <div class="breath-overview__classification">
        <ClassificationBadge classification="cu-theoretical-proposition" />
      </div>
      <p>
        The non-selectable Observable Universe marker is a separate observational reference
        positioned structurally between compression-btom and compression-ctom. It is not
        ctom, not sub-ctom, and not one of the 51 selectable TOM states.
      </p>
    </div>
  </section>

  <CosmicBreathPageGuide />
  <CosmicBreathEducation />
  <CosmicBreathTheoryAndMethod />
  <CosmicBreathEmpiricalScience />
</ContentPageLayout>

<style>
  .breath-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    scroll-margin-top: var(--space-6);
  }

  .breath-overview__diagram {
    width: min(112rem, calc(100vw - clamp(2rem, 6vw, 6rem)));
    max-width: none;
    min-width: 0;
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .breath-overview__content { width: min(100%, 48rem); }
  .breath-overview__classification { margin-top: var(--space-6); }
  .page-top-sentinel {
    display: block;
    width: 1px;
    height: 1px;
    margin-bottom: -1px;
    overflow: hidden;
    scroll-margin-top: var(--space-6);
  }
  h2 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.5rem); }
  p { margin-block: var(--space-4) 0; }
  strong { color: var(--color-cyan); }

  @media (max-width: 48rem) { .breath-overview { gap: var(--space-8); } }
</style>
