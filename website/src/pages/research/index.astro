---
import ClassificationBadge from '../../components/ClassificationBadge.astro';
import ResearchIndexSection from '../../components/ResearchIndexSection.astro';
import ResearchLegend from '../../components/ResearchLegend.astro';
import ResearchProvenanceGuide from '../../components/ResearchProvenanceGuide.astro';
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
---

<ContentPageLayout
  metaTitle="Research | Cosmic Universalism"
  metaDescription="The Cosmic Universalism research index and claim classification approach."
  eyebrow="Research"
  title="Trace each claim to the kind of support it has"
  description="The research index separates established sources from CU-authored models and propositions, making the framework easier to examine, question, and revise."
>
  <nav class="research-index-navigation" aria-label="Research index sections">
    <p>On this page</p>
    <ul>
      <li><a href="#research-classifications">Research classification vocabulary</a></li>
      <li><a href="#research-statuses">Research status vocabulary</a></li>
      <li><a href="#research-pathways">Research pathways</a></li>
      <li><a href="#open-questions">Open questions</a></li>
      <li><a href="#historical-record">Historical and superseded material</a></li>
      <li><a href="#source-provenance">Source and provenance standard</a></li>
    </ul>
  </nav>

  <ResearchLegend variant="complete" />

  <ResearchIndexSection id="research-pathways" title="Research pathways">
    <div class="research-groups">
      <article>
        <ClassificationBadge classification="empirical-reference" />
        <h3>Scientific context</h3>
        <p>
          Observations, measurements, and published research belong here as external
          references. Their inclusion does not make a CU interpretation empirical.
        </p>
      </article>
      <article>
        <div class="research-groups__classifications">
          <ClassificationBadge classification="cu-mathematical-model" />
          <ClassificationBadge classification="cu-theoretical-proposition" />
        </div>
        <h3>Framework work</h3>
        <p>
          CU mathematical models and theoretical propositions are identified by their
          own classifications and evaluated on their stated assumptions.
        </p>
      </article>
      <article>
        <div class="research-groups__classifications">
          <ClassificationBadge classification="philosophical-interpretation" />
          <ClassificationBadge classification="open-question" />
        </div>
        <h3>Interpretive and unresolved work</h3>
        <p>
          Philosophical interpretations address questions of meaning and significance
          without being presented as empirical conclusions. Open questions identify
          unresolved definitions, contradictions, or research problems that require
          further work.
        </p>
      </article>
    </div>
  </ResearchIndexSection>

  <ResearchIndexSection
    id="open-questions"
    title="Open questions"
    description="Unresolved problems are retained as questions to encourage falsifiability, clearer definitions, and productive criticism."
    classification="open-question"
  />

  <ResearchIndexSection
    id="historical-record"
    title="Historical and superseded material"
    description="Earlier interpretations will remain available as part of the project record. Historical / Superseded identifies the material’s editorial classification; Superseded or Archived describes its research lifecycle."
  />

  <ResearchIndexSection
    id="source-provenance"
    title="Source and provenance standard"
    description="Future research entries will identify their original CU repository file separately from external empirical references, together with version, last-reviewed date, and revision history."
  >
    <ResearchProvenanceGuide />
    <p class="research-provenance-note">
      Where empirical material is cited, the external reference should remain distinct
      from the CU claim that interprets or uses it. A reader should be able to identify
      which source supports the empirical context and which statements originate within
      the CU framework.
    </p>
  </ResearchIndexSection>
</ContentPageLayout>

<style>
  .research-index-navigation {
    padding: var(--space-6);
    border: 1px solid var(--color-translucent-blue);
    background: var(--color-surface-translucent);
  }

  .research-index-navigation p {
    margin: 0;
    color: var(--color-white-gold);
    font-weight: 700;
  }

  .research-index-navigation ul {
    display: flex;
    margin: var(--space-4) 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
  }

  .research-index-navigation a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
  }

  :global(.research-legend--complete) {
    margin-top: var(--space-12);
    scroll-margin-top: var(--space-6);
  }

  .research-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  article {
    padding: var(--space-6);
    border: 1px solid var(--color-translucent-blue);
    background: var(--color-surface-translucent);
    scroll-margin-top: var(--space-6);
  }

  .research-groups__classifications {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .research-provenance-note {
    max-width: var(--measure-readable);
    margin-top: var(--space-8);
  }

  h3 { margin: var(--space-4) 0 0; font-size: 1.375rem; }
  p { margin-block: var(--space-4) 0; }

  @media (max-width: 48rem) {
    .research-groups { grid-template-columns: 1fr; }
  }

  @media (max-width: 36rem) {
    article { padding: var(--space-4); }
  }
</style>
