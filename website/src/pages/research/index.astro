---
import ClassificationBadge from '../../components/ClassificationBadge.astro';
import ResearchIndexSection from '../../components/ResearchIndexSection.astro';
import ResearchProvenanceGuide from '../../components/ResearchProvenanceGuide.astro';
import ResearchStatusBadge from '../../components/ResearchStatusBadge.astro';
import BackToTop from '../../components/page-system/BackToTop.astro';
import ContinuationNavigation from '../../components/page-system/ContinuationNavigation.astro';
import EditorialSectionHeading from '../../components/page-system/EditorialSectionHeading.astro';
import EpistemicCallout from '../../components/page-system/EpistemicCallout.astro';
import FullWidthFeaturePanel from '../../components/page-system/FullWidthFeaturePanel.astro';
import PageGuide from '../../components/page-system/PageGuide.astro';
import SourceProvenancePanel from '../../components/page-system/SourceProvenancePanel.astro';
import ResearchObservatory from '../../components/research/ResearchObservatory.astro';
import {
  allResearchClassifications,
  allResearchStatuses,
} from '../../data/research-taxonomy';
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';

const pageGuideGroups = [
  {
    label: 'Research sections',
    links: [
      {
        label: 'CU Research Observatory',
        targetId: 'research-observatory',
      },
      {
        label: 'Research labels',
        targetId: 'research-labels',
      },
      {
        label: 'Open Questions',
        targetId: 'open-questions',
      },
      {
        label: 'Historical Archive',
        targetId: 'historical-record',
      },
      {
        label: 'Sources & Methods',
        targetId: 'source-provenance',
      },
    ],
  },
] as const;
---

<ContentPageLayout
  metaTitle="Research | Cosmic Universalism"
  metaDescription="Explore the Cosmic Universalism Research Observatory, its research areas, relationships, classifications, sources, and open questions."
  eyebrow="COSMIC UNIVERSALISM RESEARCH"
  title="Research, Philosophy & Open Questions"
  description="Explore relationships among Cosmic Breath, CU-Time, consciousness, artificial intelligence and alignment, Free Will, ethics and memory, empirical science, sources and methods, open questions, and historical research. Classifications and lifecycle statuses distinguish areas with different authority, evidence, and stages of development."
>
  <span id="research-page-top" class="research-page-top" aria-hidden="true"></span>

  <PageGuide
    id="research-page-guide"
    ariaLabel="Research page guide"
    title="Explore Research"
    groups={pageGuideGroups}
  />

  <FullWidthFeaturePanel
    id="research-observatory-feature"
    ariaLabel="CU Research Observatory feature"
  >
    <ResearchObservatory />
  </FullWidthFeaturePanel>

  <section
    class="research-labels"
    id="research-labels"
    aria-labelledby="research-labels-title"
  >
    <EditorialSectionHeading
      title="Understanding research labels"
      headingId="research-labels-title"
      lead="Research entries use two separate kinds of labels so readers can identify both the material’s purpose and its present state."
    />

    <div class="research-labels__groups">
      <section aria-labelledby="research-classifications">
        <h3 id="research-classifications">Classifications</h3>
        <p>
          Classifications describe what kind of material an entry contains.
        </p>
        <ul class="research-labels__list" role="list">
          {
            allResearchClassifications.map((classification) => (
              <li>
                <ClassificationBadge
                  classification={classification}
                  showDescription={true}
                />
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="research-statuses">
        <h3 id="research-statuses">Lifecycle statuses</h3>
        <p>
          Lifecycle statuses describe an entry’s current research or editorial state.
          A status does not change its classification or establish scientific validity.
        </p>
        <ul class="research-labels__list" role="list">
          {
            allResearchStatuses.map((status) => (
              <li>
                <ResearchStatusBadge status={status} showDescription={true} />
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>

  <ResearchIndexSection
    id="open-questions"
    title="Open Questions"
    description="Unresolved problems are retained as questions to encourage falsifiability, clearer definitions, and productive criticism."
    classification="open-question"
  />

  <ResearchIndexSection
    id="historical-record"
    title="Historical Archive"
    description="The archive preserves historical, superseded, and archived material as part of the project record. Historical / Superseded identifies the material’s classification; Superseded or Archived describes its research lifecycle."
  />

  <SourceProvenancePanel
    id="source-provenance"
    title="Sources, Methods & Provenance"
    headingLevel="h2"
  >
    <p>
      Future research entries will identify their original CU repository source
      separately from external empirical references, together with version,
      last-reviewed date, and revision history.
    </p>
    <ResearchProvenanceGuide />
    <EpistemicCallout kind="method" label="Source distinction">
      <p>
        Where empirical material is cited, the external reference should remain distinct
        from the CU claim that interprets or uses it. A reader should be able to identify
        which source supports the empirical context and which statements originate within
        the CU framework.
      </p>
    </EpistemicCallout>
  </SourceProvenancePanel>

  <BackToTop
    id="research-back-to-top"
    targetId="research-page-top"
    revealAfterId="research-observatory"
  />

  <ContinuationNavigation
    ariaLabel="Continue from Research"
    title="Continue to Media"
    description="Explore CU publications, media, and public communication"
    path="media/"
  />
</ContentPageLayout>

<style>
  .research-page-top {
    display: block;
    scroll-margin-top: var(--space-6);
  }

  .research-labels {
    margin-top: var(--space-editorial-section);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-section);
    scroll-margin-top: var(--space-6);
  }

  .research-labels__groups {
    display: grid;
    margin-top: var(--space-8);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .research-labels__groups > section {
    min-width: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border-quiet);
    background: var(--color-panel-quiet);
    scroll-margin-top: var(--space-6);
  }

  .research-labels__groups h3 {
    margin: 0;
    color: var(--color-white-gold);
    font-size: 1.375rem;
  }

  .research-labels__list {
    display: grid;
    margin: var(--space-4) 0 0;
    padding: 0;
    gap: var(--space-3);
    list-style: none;
  }

  .research-labels__list li {
    min-width: 0;
  }

  :global(#source-provenance.source-provenance-panel) {
    margin-top: var(--space-editorial-section);
    scroll-margin-top: var(--space-6);
  }

  :global(#source-provenance .research-provenance-guide),
  :global(#source-provenance .epistemic-callout) {
    margin-top: var(--space-8);
  }

  p { margin-block: var(--space-4) 0; }

  @media (max-width: 48rem) {
    .research-labels__groups { grid-template-columns: 1fr; }
  }

  @media (max-width: 36rem) {
    .research-labels {
      padding-top: var(--space-6);
    }

    .research-labels__groups > section {
      padding: var(--space-4);
    }
  }
</style>
