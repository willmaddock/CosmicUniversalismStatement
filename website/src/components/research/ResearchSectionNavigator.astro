---
const sections = [
  {
    href: '#research-observatory',
    number: '01',
    label: 'Research Map',
  },
  {
    href: '#research-relationship-matrix',
    number: '02',
    label: 'Relationship Matrix',
  },
  {
    href: '#source-provenance',
    number: '03',
    label: 'Sources & Methods',
  },
  {
    href: '#open-questions',
    number: '04',
    label: 'Open Questions',
  },
  {
    href: '#historical-record',
    number: '05',
    label: 'Historical Archive',
  },
] as const;
---

<nav
  class="research-section-navigator"
  aria-label="Research Observatory sections"
>
  <div
    class="research-section-navigator__scroll"
    tabindex="0"
    role="region"
    aria-label="Scrollable Research Observatory section navigation"
  >
    <ol role="list">
      {
        sections.map((section) => (
          <li>
            <a href={section.href}>
              <span
                class="research-section-navigator__number"
                aria-hidden="true"
              >
                {section.number}
              </span>
              <span>{section.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .research-section-navigator {
    position: sticky;
    z-index: 8;
    top: var(--space-3);
    min-width: 0;
    margin-block: var(--space-8);
    border: 1px solid var(--color-border-feature);
    background:
      color-mix(
        in srgb,
        var(--color-deep-navy-black) 94%,
        transparent
      );
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 24%);
    backdrop-filter: blur(1rem);
  }

  .research-section-navigator__scroll {
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .research-section-navigator ol {
    display: grid;
    min-width: max-content;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(5, minmax(10.5rem, 1fr));
    list-style: none;
  }

  .research-section-navigator li {
    min-width: 0;
    border-right: 1px solid var(--color-border-quiet);
  }

  .research-section-navigator li:last-child {
    border-right: 0;
  }

  .research-section-navigator a {
    position: relative;
    display: flex;
    min-height: 3.75rem;
    padding: var(--space-3) var(--space-4);
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-decoration: none;
    white-space: nowrap;
  }

  .research-section-navigator a::after {
    position: absolute;
    height: 0.1875rem;
    background: var(--color-cyan);
    content: '';
    inset: auto var(--space-4) 0;
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .research-section-navigator a:hover,
  .research-section-navigator a:focus-visible {
    background: var(--color-panel-quiet);
    color: var(--color-white-gold);
  }

  .research-section-navigator a:hover::after,
  .research-section-navigator a:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .research-section-navigator a:focus-visible {
    outline: 0.1875rem solid var(--color-cyan);
    outline-offset: -0.1875rem;
  }

  .research-section-navigator__number {
    color: var(--color-amber);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 64rem) {
    .research-section-navigator {
      top: var(--space-2);
    }

    .research-section-navigator::after {
      position: absolute;
      z-index: 2;
      width: 2.75rem;
      pointer-events: none;
      background:
        linear-gradient(
          90deg,
          transparent,
          color-mix(
            in srgb,
            var(--color-deep-navy-black) 96%,
            transparent
          )
        );
      content: '';
      inset: 0 0 0 auto;
    }

    .research-section-navigator ol {
      display: flex;
    }

    .research-section-navigator li {
      flex: 0 0 auto;
    }

    .research-section-navigator a {
      min-width: 10.5rem;
    }
  }

  @media (max-width: 48rem) {
    .research-section-navigator {
      top: calc(var(--space-2) + env(safe-area-inset-top, 0px));
      margin-inline: calc(var(--space-4) * -1);
      border-inline: 0;
    }

    .research-section-navigator__scroll {
      scroll-padding-inline: var(--space-4);
    }

    .research-section-navigator a {
      min-width: 9.5rem;
      min-height: 3.5rem;
      padding-inline: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-section-navigator a::after {
      transition: none;
    }
  }
</style>
