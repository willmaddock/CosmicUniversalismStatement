---
import type { CuciiConversation } from '../../lib/cucii/types';

interface Props { conversation: CuciiConversation }
const { conversation } = Astro.props;
const platformLabel = conversation.platform === 'chatgpt' ? 'ChatGPT' : 'Grok';
---

<article class="conversation-card">
  <div class="conversation-card__topline">
    <span class="conversation-card__platform">{platformLabel}</span>
    <span>{conversation.mode}</span>
  </div>
  <h3>{conversation.title}</h3>
  <dl>
    <div><dt>Role-play</dt><dd>{conversation.rolePlay}</dd></div>
    <div><dt>Menu</dt><dd>{conversation.menuMode}</dd></div>
    <div><dt>Intended use</dt><dd>{conversation.purpose}</dd></div>
  </dl>
  <p>{conversation.description}</p>
  <p class="conversation-card__disclosure"><strong>External link disclosure:</strong> {conversation.disclosure}</p>
  <p class="conversation-card__review">Last reviewed: {conversation.lastReviewed}</p>
  <a class="conversation-card__link" href={conversation.url} target="_blank" rel="noopener noreferrer">{conversation.externalLinkLabel}</a>
</article>

<style>
  .conversation-card { display: grid; grid-template-rows: auto auto auto auto 1fr auto auto; gap: var(--space-3); min-width: 0; padding: var(--space-6); border: 1px solid var(--color-translucent-blue); background: var(--color-surface-translucent); }
  .conversation-card__topline { display: flex; justify-content: space-between; gap: var(--space-3); color: var(--color-text-muted); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
  .conversation-card__platform { color: var(--color-cyan); font-weight: 700; }
  h3 { margin: 0; color: var(--color-white-gold); font-size: 1.35rem; }
  p { margin: 0; }
  dl { display: grid; gap: var(--space-2); margin: 0; }
  dl div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--space-3); }
  dt { color: var(--color-text-muted); font-size: .8rem; font-weight: 700; text-transform: uppercase; }
  dd { margin: 0; }
  .conversation-card__disclosure { color: var(--color-amber); font-size: .9rem; }
  .conversation-card__review { color: var(--color-text-muted); font-size: .85rem; }
  .conversation-card__link { align-self: end; margin-top: auto; color: var(--color-cyan); font-weight: 700; overflow-wrap: anywhere; }
  @media (max-width: 36rem) { .conversation-card { padding: var(--space-4); } dl div { grid-template-columns: 1fr; gap: 0; } }
</style>
