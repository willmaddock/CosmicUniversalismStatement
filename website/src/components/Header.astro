---
import {
  isCurrentPath,
  primaryAction,
  primaryNavigation,
  sitePath,
} from '../config/site';

const currentPathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      class="site-identity"
      href={sitePath('')}
      aria-label="Cosmic Universalism home"
      aria-current={isCurrentPath(currentPathname, '/') ? 'page' : undefined}
    >
      <span class="site-identity__name">COSMIC UNIVERSALISM</span>
      <span class="site-identity__initiative">Computational Intelligence Initiative</span>
    </a>

    <div class="site-header__navigation-region">
      <nav class="primary-navigation" aria-label="Primary navigation">
        <ul class="primary-navigation__list">
          {
            primaryNavigation.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                  aria-current={isCurrentPath(currentPathname, href) ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a
        class="site-header__action"
        href={primaryAction.href}
        aria-current={
          isCurrentPath(currentPathname, primaryAction.href) ? 'page' : undefined
        }
      >
        {primaryAction.label}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    border-bottom: 1px solid var(--color-translucent-blue);
    background: var(--color-background);
  }

  .site-header__inner {
    display: flex;
    width: min(100% - (2 * var(--space-6)), 90rem);
    margin-inline: auto;
    padding-block: var(--space-4);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-identity {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    color: var(--color-text);
    flex-direction: column;
    justify-content: center;
    text-decoration: none;
  }

  .site-identity__name {
    color: var(--color-white-gold);
    font-family: var(--font-family-serif);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .site-identity__initiative {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .site-header__navigation-region {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-6);
  }

  .primary-navigation__list {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
  }

  .primary-navigation a,
  .site-header__action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .primary-navigation a {
    padding-inline: var(--space-2);
    color: var(--color-text);
  }

  .primary-navigation a:hover {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .primary-navigation a[aria-current='page'] {
    color: var(--color-cyan);
    text-decoration: underline;
    text-decoration-thickness: 0.125rem;
    text-underline-offset: 0.35em;
  }

  .site-header__action {
    flex: 0 0 auto;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-amber);
    background: var(--color-surface-translucent);
    color: var(--color-white-gold);
  }

  .site-header__action:hover {
    background: var(--color-amber);
    color: var(--color-deep-navy-black);
  }

  .site-header__action[aria-current='page'] {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
  }

  .site-identity:focus-visible,
  .primary-navigation a:focus-visible,
  .site-header__action:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-cyan);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 64rem) {
    .site-header__inner,
    .site-header__navigation-region {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-header__navigation-region {
      width: 100%;
      gap: var(--space-4);
    }

    .primary-navigation__list {
      justify-content: flex-start;
    }
  }

  @media (max-width: 36rem) {
    .site-header__inner {
      width: min(100% - (2 * var(--space-4)), 90rem);
    }

    .primary-navigation,
    .primary-navigation__list {
      width: 100%;
    }

    .primary-navigation__list {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .primary-navigation a,
    .site-header__action {
      width: 100%;
    }
  }
</style>