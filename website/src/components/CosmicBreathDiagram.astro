---
const diagramId = `cosmic-breath-${crypto.randomUUID()}`;
const titleId = `${diagramId}-title`;
const descriptionId = `${diagramId}-description`;
const shellFillId = `${diagramId}-shell-fill`;
const shellStrokeId = `${diagramId}-shell-stroke`;
const seedFillId = `${diagramId}-seed-fill`;
const seedHaloId = `${diagramId}-seed-halo`;
const ztomClipId = `${diagramId}-ztom-clip`;
const diagramCenter = Object.freeze({ x: 320, y: 300 });
const compressionBtomRadius = 142;
const compressionCtomRadius = 196;
const observableMarkerRadius = (compressionBtomRadius + compressionCtomRadius) / 2;
const observableMarkerAngle = Math.atan2(20, 162);
const observableMarker = Object.freeze({
  x: Number((diagramCenter.x + (Math.cos(observableMarkerAngle) * observableMarkerRadius)).toFixed(1)),
  y: Number((diagramCenter.y + (Math.sin(observableMarkerAngle) * observableMarkerRadius)).toFixed(1)),
});
const observableLabel = Object.freeze({
  x: observableMarker.x - 34,
  y: observableMarker.y + 62,
});
---

<figure class="cosmic-breath-diagram">
  <svg
    class="cosmic-breath-diagram__svg"
    viewBox="0 0 640 620"
    role="img"
    aria-labelledby={`${titleId} ${descriptionId}`}
    focusable="false"
    style={`--diagram-shell-fill: url(#${shellFillId}); --diagram-shell-stroke: url(#${shellStrokeId}); --diagram-seed-fill: url(#${seedFillId}); --diagram-seed-halo: url(#${seedHaloId});`}
  >
    <title id={titleId}>Cosmic Breath nested structural levels</title>
    <desc id={descriptionId}>
      Structural Cosmic Universalism diagram with a non-selectable Observable Universe
      marker positioned between compression-btom and compression-ctom. The marker is not
      one of the 51 TOM states, and the diagram is not drawn to physical or temporal scale.
    </desc>

    <defs>
      <radialGradient id={shellFillId} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-translucent-blue)" stop-opacity="0.05" />
        <stop offset="74%" stop-color="var(--color-translucent-blue)" stop-opacity="0.12" />
        <stop offset="100%" stop-color="var(--color-translucent-blue)" stop-opacity="0.42" />
      </radialGradient>
      <linearGradient id={shellStrokeId} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--color-white-gold)" stop-opacity="0.48" />
        <stop offset="38%" stop-color="var(--color-translucent-blue)" stop-opacity="0.82" />
        <stop offset="100%" stop-color="var(--color-cyan)" stop-opacity="0.44" />
      </linearGradient>
      <radialGradient id={seedFillId} cx="50%" cy="46%" r="54%">
        <stop offset="0%" stop-color="var(--color-white-gold)" stop-opacity="0.92" />
        <stop offset="24%" stop-color="var(--color-white-gold)" stop-opacity="0.52" />
        <stop offset="100%" stop-color="var(--color-translucent-blue)" stop-opacity="0.42" />
      </radialGradient>
      <radialGradient id={seedHaloId} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-white-gold)" stop-opacity="0.22" />
        <stop offset="48%" stop-color="var(--color-white-gold)" stop-opacity="0.08" />
        <stop offset="100%" stop-color="var(--color-white-gold)" stop-opacity="0" />
      </radialGradient>
      <clipPath id={ztomClipId}>
        <circle cx="320" cy="300" r="248" />
      </clipPath>
    </defs>

    <g class="cosmic-breath-diagram__shell-depth" aria-hidden="true">
      <circle class="cosmic-breath-diagram__shell-fill cosmic-breath-diagram__shell-fill--ztom" cx="320" cy="300" r="248" />
      <circle class="cosmic-breath-diagram__shell-fill cosmic-breath-diagram__shell-fill--ctom" cx="320" cy="300" r="196" />
      <circle class="cosmic-breath-diagram__shell-fill cosmic-breath-diagram__shell-fill--btom" cx="320" cy="300" r="142" />
      <circle class="cosmic-breath-diagram__shell-fill cosmic-breath-diagram__shell-fill--atom" cx="320" cy="300" r="92" />
    </g>

    <g class="cosmic-breath-diagram__star-field" clip-path={`url(#${ztomClipId})`} aria-hidden="true">
      <circle cx="143" cy="190" r="1.4" />
      <circle class="cosmic-breath-diagram__star--secondary" cx="197" cy="111" r="1" />
      <circle cx="281" cy="74" r="1.2" />
      <circle class="cosmic-breath-diagram__star--secondary" cx="414" cy="91" r="1.3" />
      <circle cx="511" cy="181" r="1" />
      <circle class="cosmic-breath-diagram__star--secondary" cx="536" cy="291" r="1.4" />
      <circle cx="495" cy="432" r="1.1" />
      <circle class="cosmic-breath-diagram__star--secondary" cx="412" cy="502" r="1.3" />
      <circle cx="244" cy="520" r="1" />
      <circle class="cosmic-breath-diagram__star--secondary" cx="118" cy="402" r="1.2" />
      <circle cx="104" cy="280" r="1" />
      <circle class="cosmic-breath-diagram__star--secondary" cx="178" cy="338" r="0.9" />
    </g>

    <circle class="cosmic-breath-diagram__seed-halo" cx="320" cy="300" r="58" aria-hidden="true" />

    <g class="cosmic-breath-diagram__geometry" aria-hidden="true">
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--ztom" cx="320" cy="300" r="248" />
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--ctom" cx="320" cy="300" r="196" />
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--btom" cx="320" cy="300" r="142" />
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--atom" cx="320" cy="300" r="92" />
      <circle class="cosmic-breath-diagram__seed" cx="320" cy="300" r="30" />
    </g>

    <circle class="cosmic-breath-diagram__seed-core" cx="320" cy="300" r="6" aria-hidden="true" />

    <g class="cosmic-breath-diagram__labels" aria-hidden="true">
      <text x="320" y="84" text-anchor="middle">ztom</text>
      <text x="320" y="136" text-anchor="middle">ctom</text>
      <text x="320" y="190" text-anchor="middle">btom</text>
      <text x="320" y="240" text-anchor="middle">atom</text>
      <text class="cosmic-breath-diagram__seed-label" x="320" y="306" text-anchor="middle">sub-ztom</text>
    </g>

    <g
      class="cosmic-breath-diagram__observable-marker"
      aria-hidden="true"
      style="pointer-events: none; user-select: none;"
    >
      <circle class="cosmic-breath-diagram__marker-outer" cx={observableMarker.x} cy={observableMarker.y} r="16" />
      <circle class="cosmic-breath-diagram__marker-ring" cx={observableMarker.x} cy={observableMarker.y} r="10" />
      <circle class="cosmic-breath-diagram__marker-core" cx={observableMarker.x} cy={observableMarker.y} r="3" />
      <path d={`M ${observableMarker.x} ${observableMarker.y - 20} V ${observableMarker.y - 10} M ${observableMarker.x} ${observableMarker.y + 10} V ${observableMarker.y + 20} M ${observableMarker.x - 20} ${observableMarker.y} H ${observableMarker.x - 10} M ${observableMarker.x + 10} ${observableMarker.y} H ${observableMarker.x + 20}`} />
      <path class="cosmic-breath-diagram__marker-leader" d={`M ${observableMarker.x - 7} ${observableMarker.y + 9} L ${observableMarker.x - 30} ${observableMarker.y + 37}`} />
      <text x={observableLabel.x} y={observableLabel.y} text-anchor="middle">
        <tspan class="cosmic-breath-diagram__marker-heading" x={observableLabel.x} dy="0">You Are Here</tspan>
        <tspan class="cosmic-breath-diagram__marker-detail" x={observableLabel.x} dy="25">Observable Universe</tspan>
      </text>
    </g>
  </svg>
</figure>

<style>
  .cosmic-breath-diagram {
    width: min(100%, 40rem);
    margin: 0;
  }

  .cosmic-breath-diagram__svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--color-text);
    overflow: visible;
  }

  .cosmic-breath-diagram__shell-fill {
    fill: var(--diagram-shell-fill);
  }

  .cosmic-breath-diagram__shell-fill--ztom {
    opacity: 0.52;
  }

  .cosmic-breath-diagram__shell-fill--ctom {
    opacity: 0.44;
  }

  .cosmic-breath-diagram__shell-fill--btom {
    opacity: 0.36;
  }

  .cosmic-breath-diagram__shell-fill--atom {
    opacity: 0.28;
  }

  .cosmic-breath-diagram__star-field {
    fill: var(--color-white-gold);
    opacity: 0.58;
  }

  .cosmic-breath-diagram__star--secondary {
    opacity: 0.52;
  }

  .cosmic-breath-diagram__seed-halo {
    fill: var(--diagram-seed-halo);
  }

  .cosmic-breath-diagram__boundary,
  .cosmic-breath-diagram__seed {
    fill: none;
    stroke: var(--diagram-shell-stroke);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .cosmic-breath-diagram__boundary--ctom {
    stroke-width: 4;
  }

  .cosmic-breath-diagram__seed {
    fill: var(--diagram-seed-fill);
    stroke: var(--color-white-gold);
    stroke-width: 4;
  }

  .cosmic-breath-diagram__seed-core {
    fill: var(--color-white-gold);
    stroke: var(--color-background);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .cosmic-breath-diagram__labels {
    fill: var(--color-white-gold);
    font-family: var(--font-family-sans);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
    paint-order: stroke;
    stroke: var(--color-background);
    stroke-linejoin: round;
    stroke-width: 5px;
  }

  .cosmic-breath-diagram__labels .cosmic-breath-diagram__seed-label {
    fill: var(--color-white-gold);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .cosmic-breath-diagram__observable-marker {
    fill: var(--color-cyan);
    pointer-events: none;
    stroke: var(--color-cyan);
    stroke-width: 3;
    user-select: none;
    vector-effect: non-scaling-stroke;
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-outer {
    fill: none;
    opacity: 0.5;
    stroke-width: 1.5;
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-ring {
    fill: var(--color-background);
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-core {
    fill: var(--color-cyan);
    stroke: none;
  }

  .cosmic-breath-diagram__observable-marker path {
    fill: none;
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-leader {
    stroke-width: 2;
  }

  .cosmic-breath-diagram__observable-marker text {
    fill: var(--color-cyan);
    paint-order: stroke;
    stroke: var(--color-background);
    stroke-linejoin: round;
    stroke-width: 6px;
    font-family: var(--font-family-sans);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-detail {
    fill: var(--color-white-gold);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media (max-width: 36rem) {
    .cosmic-breath-diagram__star--secondary {
      display: none;
    }

    .cosmic-breath-diagram__labels {
      font-size: 26px;
    }

    .cosmic-breath-diagram__labels .cosmic-breath-diagram__seed-label {
      font-size: 24px;
    }

    .cosmic-breath-diagram__observable-marker text {
      font-size: 24px;
    }

    .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-detail {
      font-size: 22px;
    }
  }
</style>
