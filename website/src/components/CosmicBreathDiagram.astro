---
const diagramId = `cosmic-breath-${crypto.randomUUID()}`;
const titleId = `${diagramId}-title`;
const descriptionId = `${diagramId}-description`;
---

<figure class="cosmic-breath-diagram">
  <svg
    class="cosmic-breath-diagram__svg"
    viewBox="0 0 640 620"
    role="img"
    aria-labelledby={`${titleId} ${descriptionId}`}
    focusable="false"
  >
    <title id={titleId}>Cosmic Breath nested structural levels</title>
    <desc id={descriptionId}>
      A concentric structural diagram with sub-ztom as the central seed, nested inside
      atom, btom, ctom, and ztom. A cyan You Are Here marker identifies the Observable
      Universe in the ctom region, outside btom and away from the central seed. Ctom is
      shown as distinct from sub-ctom, which is not depicted as one of these five labels.
    </desc>

    <g class="cosmic-breath-diagram__geometry" aria-hidden="true">
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--ztom" cx="320" cy="300" r="248" />
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--ctom" cx="320" cy="300" r="196" />
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--btom" cx="320" cy="300" r="142" />
      <circle class="cosmic-breath-diagram__boundary cosmic-breath-diagram__boundary--atom" cx="320" cy="300" r="92" />
      <circle class="cosmic-breath-diagram__seed" cx="320" cy="300" r="30" />
    </g>

    <g class="cosmic-breath-diagram__labels" aria-hidden="true">
      <text x="320" y="84" text-anchor="middle">ztom</text>
      <text x="320" y="136" text-anchor="middle">ctom</text>
      <text x="320" y="190" text-anchor="middle">btom</text>
      <text x="320" y="240" text-anchor="middle">atom</text>
      <text class="cosmic-breath-diagram__seed-label" x="320" y="306" text-anchor="middle">sub-ztom</text>
    </g>

    <g class="cosmic-breath-diagram__observable-marker" aria-hidden="true">
      <circle cx="482" cy="320" r="10" />
      <path d="M 482 300 V 310 M 482 330 V 340 M 462 320 H 472 M 492 320 H 502" />
      <path class="cosmic-breath-diagram__marker-leader" d="M 475 329 L 452 357" />
      <text x="448" y="382" text-anchor="middle">
        <tspan class="cosmic-breath-diagram__marker-heading" x="448" dy="0">You Are Here</tspan>
        <tspan class="cosmic-breath-diagram__marker-detail" x="448" dy="25">Observable Universe</tspan>
      </text>
    </g>
  </svg>
</figure>

<style>
  .cosmic-breath-diagram {
    width: min(100%, 40rem);
    margin: 0;
  }

  .cosmic-breath-diagram__svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--color-text);
    overflow: visible;
  }

  .cosmic-breath-diagram__boundary,
  .cosmic-breath-diagram__seed {
    fill: none;
    stroke: var(--color-translucent-blue);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .cosmic-breath-diagram__boundary--ctom {
    stroke-width: 4;
  }

  .cosmic-breath-diagram__seed {
    fill: var(--color-surface-translucent);
    stroke: var(--color-white-gold);
    stroke-width: 4;
  }

  .cosmic-breath-diagram__labels {
    fill: var(--color-white-gold);
    font-family: var(--font-family-sans);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
    paint-order: stroke;
    stroke: var(--color-background);
    stroke-linejoin: round;
    stroke-width: 6px;
  }

  .cosmic-breath-diagram__labels .cosmic-breath-diagram__seed-label {
    fill: var(--color-white-gold);
    font-size: 16px;
    letter-spacing: 0;
  }

  .cosmic-breath-diagram__observable-marker {
    fill: var(--color-cyan);
    stroke: var(--color-cyan);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .cosmic-breath-diagram__observable-marker circle {
    fill: var(--color-background);
  }

  .cosmic-breath-diagram__observable-marker path {
    fill: none;
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-leader {
    stroke-width: 2;
  }

  .cosmic-breath-diagram__observable-marker text {
    fill: var(--color-cyan);
    paint-order: stroke;
    stroke: var(--color-background);
    stroke-linejoin: round;
    stroke-width: 6px;
    font-family: var(--font-family-sans);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-detail {
    fill: var(--color-white-gold);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media (max-width: 36rem) {
    .cosmic-breath-diagram__labels {
      font-size: 26px;
    }

    .cosmic-breath-diagram__labels .cosmic-breath-diagram__seed-label {
      font-size: 24px;
    }

    .cosmic-breath-diagram__observable-marker text {
      font-size: 24px;
    }

    .cosmic-breath-diagram__observable-marker .cosmic-breath-diagram__marker-detail {
      font-size: 22px;
    }
  }
</style>
