---
import { sitePath } from '../../config/site';

interface Props {
  ariaLabel: string;
  title: string;
  description: string;
  path: string;
}

const {
  ariaLabel,
  title,
  description,
  path,
} = Astro.props;
---

<nav class="continuation-navigation" aria-label={ariaLabel}>
  <a href={sitePath(path)}>
    <span class="continuation-navigation__cue">Continue</span>
    <span class="continuation-navigation__content">
      <strong>{title}</strong>
      <span>{description}</span>
    </span>
    <span class="continuation-navigation__direction" aria-hidden="true">
      Forward →
    </span>
  </a>
</nav>

<style>
  .continuation-navigation {
    width: 100%;
    margin-top: var(--space-editorial-section);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-section);
  }

  .continuation-navigation a {
    display: grid;
    min-height: 2.75rem;
    padding: clamp(var(--space-6), 4vw, var(--space-8));
    grid-template-columns: minmax(7rem, 0.35fr) minmax(0, 1fr) minmax(8rem, 0.4fr);
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    overflow: hidden;
    border: 1px solid var(--color-border-feature);
    border-radius: 1rem;
    background:
      radial-gradient(
        circle at 100% 50%,
        color-mix(in srgb, var(--color-cyan) 12%, transparent),
        transparent 24rem
      ),
      var(--color-panel-feature);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: 0 1.5rem 3.5rem rgb(0 5 16 / 18%);
  }

  .continuation-navigation a:hover {
    border-color: var(--color-cyan);
    background: var(--color-panel-quiet);
  }

  .continuation-navigation__cue {
    color: var(--color-amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .continuation-navigation__content {
    display: grid;
    min-width: 0;
    gap: var(--space-1);
  }

  .continuation-navigation__content strong {
    overflow-wrap: anywhere;
    color: var(--color-white-gold);
    font-family: var(--font-family-serif);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: var(--line-height-heading);
  }

  .continuation-navigation__content > span {
    color: var(--color-text-muted);
  }

  .continuation-navigation__direction {
    display: flex;
    min-height: 3.5rem;
    padding-left: var(--space-6);
    align-items: center;
    justify-content: flex-end;
    color: var(--color-cyan);
    font-weight: 700;
    border-left: 1px solid var(--color-border-section);
    white-space: nowrap;
  }

  .continuation-navigation a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-cyan);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 48rem) {
    .continuation-navigation a {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-3);
    }

    .continuation-navigation__direction {
      min-height: 2.75rem;
      padding: var(--space-3) 0 0;
      justify-content: flex-start;
      border-top: 1px solid var(--color-border-section);
      border-left: 0;
      white-space: normal;
    }
  }

  @media (max-width: 36rem) {
    .continuation-navigation a {
      padding: var(--space-4);
      border-radius: 0.75rem;
    }
  }
</style>
