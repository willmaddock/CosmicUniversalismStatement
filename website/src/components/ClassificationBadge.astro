---
import {
  researchClassifications,
  type ResearchClassification,
} from '../data/research-taxonomy';

interface Props {
  classification: ResearchClassification;
  showDescription?: boolean;
}

const {
  classification,
  showDescription = false,
} = Astro.props;
const definition = researchClassifications[classification];
---

<span
  class:list={[
    'classification-badge',
    `classification-badge--${definition.tone}`,
    { 'classification-badge--descriptive': showDescription },
  ]}
  data-research-classification={classification}
>
  <span class="classification-badge__marker" aria-hidden="true">
    {definition.marker}
  </span>
  <span class="classification-badge__content">
    <span class="classification-badge__label">{definition.label}</span>
    {
      showDescription && (
        <span class="classification-badge__description">{definition.description}</span>
      )
    }
  </span>
</span>

<style>
  .classification-badge {
    --badge-color: var(--color-white-gold);

    display: inline-flex;
    max-width: 100%;
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    align-items: center;
    gap: var(--space-2);
    border: 1px solid color-mix(in srgb, var(--badge-color) 62%, transparent);
    border-radius: 999px;
    background: var(--color-background);
    color: var(--badge-color);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .classification-badge--descriptive {
    width: 100%;
    min-height: 100%;
    padding: var(--space-3);
    align-items: flex-start;
    border-radius: 0.25rem;
  }

  .classification-badge--empirical {
    --badge-color: var(--color-cyan);
  }

  .classification-badge--mathematical,
  .classification-badge--theoretical,
  .classification-badge--philosophical {
    --badge-color: var(--color-white-gold);
  }

  .classification-badge--narrative,
  .classification-badge--historical {
    --badge-color: var(--color-muted-gray);
  }

  .classification-badge--open {
    --badge-color: var(--color-amber);
  }

  .classification-badge__marker {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-sans);
    line-height: 1;
  }

  .classification-badge__content {
    display: inline-flex;
    min-width: 0;
    flex-direction: column;
  }

  .classification-badge__label {
    color: inherit;
  }

  .classification-badge__description {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.5;
  }
</style>
