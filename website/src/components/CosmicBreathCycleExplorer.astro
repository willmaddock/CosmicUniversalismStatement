---
import CosmicBreathDiagram from './CosmicBreathDiagram.astro';
import { orderedTomStates } from '../lib/cosmicBreath/cycle-ledger';
import {
  compressionDragAnchors,
  expansionDragAnchors,
} from '../lib/cosmicBreath/cycle-drag';

const explorerId = `cosmic-breath-cycle-explorer-${crypto.randomUUID()}`;
const panelId = `${explorerId}-panel`;
const detailsId = `${explorerId}-details`;
const fieldTitleId = `${explorerId}-field-title`;
const fieldDescriptionId = `${explorerId}-field-description`;
const fieldInstructionsId = `${explorerId}-field-instructions`;
const fieldX = (value: number) => value * 100;
const fieldY = (value: number) => value * 64;
const expansionPathPoints = expansionDragAnchors
  .map((anchor) => `${fieldX(anchor.point.x)},${fieldY(anchor.point.y)}`)
  .join(' ');
const compressionPathPoints = compressionDragAnchors
  .map((anchor) => `${fieldX(anchor.point.x)},${fieldY(anchor.point.y)}`)
  .join(' ');
const initialMarker = expansionDragAnchors[0].point;
const atomAnchor = expansionDragAnchors[expansionDragAnchors.length - 1];
const ztomAnchor = compressionDragAnchors[compressionDragAnchors.length - 1];
---

<section
  class="cycle-explorer"
  data-cosmic-breath-explorer
  aria-labelledby={`${explorerId}-title`}
>
  <div class="cycle-explorer__overview" data-overview>
    <CosmicBreathDiagram />
    <div class="cycle-explorer__entry">
      <h3 id={`${explorerId}-title`}>Explore the structural Cosmic Breath cycle</h3>
      <p>
        The original five-shell overview remains the reference view. The explorer uses
        the 51 owner-approved structural TOM positions without displaying disputed time,
        quantum notation, formulas, magnitudes, or chronology-sensitive descriptions.
      </p>
      <button
        class="cycle-explorer__button cycle-explorer__button--primary"
        type="button"
        aria-controls={panelId}
        aria-disabled="true"
        disabled
        data-explore
      >
        Explore the Cycle
      </button>
      <p class="cycle-explorer__availability" data-js-availability>
        Interactive controls require JavaScript. The complete structural inventory
        remains available below.
      </p>
    </div>
  </div>

  <section
    id={panelId}
    class="cycle-explorer__panel"
    aria-labelledby={`${explorerId}-simulation-title`}
    tabindex="-1"
    hidden
    data-explorer-panel
  >
    <header class="cycle-explorer__header">
      <div>
        <p class="cycle-explorer__eyebrow">Structural cycle explorer</p>
        <h3 id={`${explorerId}-simulation-title`}>Simulated Cosmic State</h3>
        <p>
          This educational structural model is a CU theoretical proposition. It is not
          a scale drawing, observational map, or empirical measurement, and it does not
          move the physical universe.
        </p>
      </div>
      <p class="cycle-explorer__cycle-count" data-cycle-count>
        Cosmic Breath sequence: 1
      </p>
    </header>

    <figure class="cycle-explorer__field">
      <svg
        class="cycle-explorer__field-svg"
        viewBox="0 0 100 64"
        role="img"
        aria-labelledby={`${fieldTitleId} ${fieldDescriptionId}`}
        aria-describedby={fieldInstructionsId}
        data-drag-surface
        data-active-phase="expansion"
        style={`--field-glow: url(#${explorerId}-field-glow);`}
      >
        <title id={fieldTitleId}>Index-based Cosmic Breath structural drag field</title>
        <desc id={fieldDescriptionId}>
          A non-scale CU theoretical visualization with a solid expansion path of circular
          anchors and a dashed compression path of diamond anchors. The Simulated Cosmic
          State can be moved by pointer and snaps only to anchors in its active phase.
        </desc>
        <defs>
          <radialGradient id={`${explorerId}-field-glow`} cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="var(--color-cyan)" stop-opacity="0.16" />
            <stop offset="100%" stop-color="var(--color-cyan)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect class="cycle-explorer__field-background" x="0" y="0" width="100" height="64" rx="3" />
        <circle class="cycle-explorer__field-center" cx="50" cy="32" r="14" />
        <polyline
          class="cycle-explorer__path cycle-explorer__path--expansion"
          points={expansionPathPoints}
          aria-hidden="true"
        />
        <polyline
          class="cycle-explorer__path cycle-explorer__path--compression"
          points={compressionPathPoints}
          aria-hidden="true"
        />
        <g class="cycle-explorer__anchors cycle-explorer__anchors--expansion" aria-hidden="true">
          {expansionDragAnchors.map((anchor) => (
            <circle
              cx={fieldX(anchor.point.x)}
              cy={fieldY(anchor.point.y)}
              r={anchor.stateId === 'expansion-atom' ? 1.15 : 0.55}
            />
          ))}
        </g>
        <g class="cycle-explorer__anchors cycle-explorer__anchors--compression" aria-hidden="true">
          {compressionDragAnchors.map((anchor) => {
            const x = fieldX(anchor.point.x);
            const y = fieldY(anchor.point.y);
            const size = anchor.stateId === 'compression-ztom' ? 1.8 : 1;
            return (
              <rect
                x={x - (size / 2)}
                y={y - (size / 2)}
                width={size}
                height={size}
                transform={`rotate(45 ${x} ${y})`}
              />
            );
          })}
        </g>
        <g class="cycle-explorer__boundary-labels" aria-hidden="true">
          <text x={fieldX(atomAnchor.point.x)} y={fieldY(atomAnchor.point.y) - 2.2} text-anchor="middle">
            atom · expansion pause
          </text>
          <text x={fieldX(ztomAnchor.point.x)} y={fieldY(ztomAnchor.point.y) + 3.4} text-anchor="middle">
            ztom · reset pause
          </text>
        </g>
        <g
          class="cycle-explorer__marker"
          transform={`translate(${fieldX(initialMarker.x)} ${fieldY(initialMarker.y)})`}
          aria-hidden="true"
          data-drag-marker
        >
          <circle class="cycle-explorer__marker-target" r="4.8" />
          <circle class="cycle-explorer__marker-halo" r="2.8" />
          <circle class="cycle-explorer__marker-core" r="1.35" />
          <path d="M -2.4 0 H 2.4 M 0 -2.4 V 2.4" />
        </g>
      </svg>
      <figcaption id={fieldInstructionsId}>
        Drag the Simulated Cosmic State with a mouse, touch, or pen, or use the buttons,
        native range, keyboard commands, and complete inventory below. This field is
        structural and index-based—not drawn to physical or temporal scale.
      </figcaption>
      <p class="cycle-explorer__drag-preview" aria-live="off" data-drag-preview>
        sub-ztom · Expansion · cycle position 1 of 51
      </p>
      <div class="cycle-explorer__field-key" aria-hidden="true">
        <span><i class="cycle-explorer__key-symbol cycle-explorer__key-symbol--expansion"></i> Expansion anchors</span>
        <span><i class="cycle-explorer__key-symbol cycle-explorer__key-symbol--compression"></i> Compression anchors</span>
      </div>
    </figure>

    <div class="cycle-explorer__preview" aria-labelledby={`${explorerId}-preview-title`}>
      <p class="cycle-explorer__eyebrow" id={`${explorerId}-preview-title`}>
        Current structural position
      </p>
      <p class="cycle-explorer__state-label" data-state-label>sub-ztom</p>
      <p class="cycle-explorer__position" data-state-position>
        Expansion · cycle position 1 of 51
      </p>
      <p class="cycle-explorer__review-note">
        Time, quantum notation, formulas, magnitudes, and chronology-sensitive
        descriptions remain under review and are intentionally withheld.
      </p>
    </div>

    <div class="cycle-explorer__controls" aria-label="Cycle navigation controls">
      <div class="cycle-explorer__button-row">
        <button class="cycle-explorer__button" type="button" data-previous>
          Previous TOM
        </button>
        <button class="cycle-explorer__button" type="button" data-next>
          Next TOM
        </button>
        <button
          class="cycle-explorer__button cycle-explorer__button--boundary"
          type="button"
          hidden
          data-begin-compression
        >
          Begin Compression
        </button>
        <button
          class="cycle-explorer__button cycle-explorer__button--boundary"
          type="button"
          hidden
          data-begin-next-breath
        >
          Begin the Next Cosmic Breath
        </button>
      </div>

      <label class="cycle-explorer__range-label" for={`${explorerId}-range`}>
        Direct structural position
        <span data-range-output>1 of 51</span>
      </label>
      <input
        id={`${explorerId}-range`}
        class="cycle-explorer__range"
        type="range"
        min="0"
        max="50"
        step="1"
        value="0"
        disabled
        data-cycle-range
      />
      <p class="cycle-explorer__keyboard-help">
        Keyboard: Left/Right moves ordinarily; Home/End jumps to the first/last state;
        Page Up/Page Down jumps to the current phase boundary; Escape returns to overview.
      </p>
    </div>

    <article
      id={detailsId}
      class="cycle-explorer__details"
      aria-labelledby={`${explorerId}-details-title`}
      hidden
      data-state-details
    >
      <h4 id={`${explorerId}-details-title`}>Approved structural details</h4>
      <dl>
        <div><dt>Label</dt><dd data-detail-label></dd></div>
        <div><dt>Phase</dt><dd data-detail-phase></dd></div>
        <div><dt>Cycle position</dt><dd data-detail-cycle></dd></div>
        <div><dt>Phase position</dt><dd data-detail-phase-position></dd></div>
        <div><dt>Ordinary previous state</dt><dd data-detail-previous></dd></div>
        <div><dt>Ordinary next state</dt><dd data-detail-next></dd></div>
        <div><dt>Boundary role</dt><dd data-detail-boundary></dd></div>
        <div><dt>Classification</dt><dd data-detail-classification></dd></div>
        <div><dt>Approval status</dt><dd data-detail-approval></dd></div>
      </dl>
    </article>

    <div class="cycle-explorer__utility-controls">
      <button class="cycle-explorer__button" type="button" data-reset>
        Reset Explorer
      </button>
      <button class="cycle-explorer__button" type="button" data-return-overview>
        Return to Overview
      </button>
    </div>
  </section>

  <details class="cycle-explorer__inventory" data-inventory>
    <summary>Complete structural TOM inventory (51 states)</summary>
    <p>
      Select any state for a direct educational jump when JavaScript is available.
      Boundary crossings remain deliberate actions in ordinary navigation.
    </p>
    <ol>
      {orderedTomStates.map((state, index) => (
        <li>
          <button
            type="button"
            disabled
            data-select-state
            data-state-index={index}
          >
            <span>{state.label}</span>
            <small>
              {state.phase === 'expansion' ? 'Expansion' : 'Compression'} · phase
              position {state.phaseIndex}
            </small>
          </button>
        </li>
      ))}
    </ol>
  </details>

  <p class="cycle-explorer__status" role="status" aria-live="polite" aria-atomic="true" data-status></p>
</section>

<script>
  import {
    getTomStateByIndex,
    orderedTomStates,
    type StructuralTomState,
  } from '../lib/cosmicBreath/cycle-ledger';
  import {
    beginDragging,
    beginNextCosmicBreath,
    completeSettling,
    continueFromAtom,
    enterExploration,
    INITIAL_CYCLE_STATE,
    moveToNextState,
    moveToPreviousState,
    releaseDragIntoSettling,
    resetCycleExplorer,
    returnToOverview,
    revealSettledDetails,
    selectStateByIndex,
    updateDragPreview,
    type CosmicBreathCycleState,
  } from '../lib/cosmicBreath/cycle-state';
  import {
    getExplorerControlState,
    getExplorerKeyboardCommand,
    getPhaseBoundaryIndices,
    getSelectionStatusText,
    getStructuralStateSummary,
    isEditableControl,
    parseStructuralIndex,
    type SelectionStatusKind,
  } from '../lib/cosmicBreath/cycle-controls';
  import {
    canonicalIndexForAnchor,
    clampNormalizedPoint,
    compactStructuralPreviewText,
    findNearestAnchorInPhase,
    getDragAnchorByCanonicalIndex,
    snappedMarkerCoordinates,
    type NormalizedPoint,
  } from '../lib/cosmicBreath/cycle-drag';

  const requiredElement = <T extends Element>(root: Element, selector: string): T => {
    const element = root.querySelector<T>(selector);
    if (!element) throw new Error(`Cosmic Breath explorer is missing ${selector}`);
    return element;
  };

  const initializeExplorer = (root: HTMLElement): void => {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const overview = requiredElement<HTMLElement>(root, '[data-overview]');
    const panel = requiredElement<HTMLElement>(root, '[data-explorer-panel]');
    const dragSurface = requiredElement<SVGSVGElement>(root, '[data-drag-surface]');
    const dragMarker = requiredElement<SVGGElement>(root, '[data-drag-marker]');
    const dragPreview = requiredElement<HTMLElement>(root, '[data-drag-preview]');
    const exploreButton = requiredElement<HTMLButtonElement>(root, '[data-explore]');
    const availability = requiredElement<HTMLElement>(root, '[data-js-availability]');
    const previousButton = requiredElement<HTMLButtonElement>(root, '[data-previous]');
    const nextButton = requiredElement<HTMLButtonElement>(root, '[data-next]');
    const beginCompressionButton = requiredElement<HTMLButtonElement>(root, '[data-begin-compression]');
    const beginNextBreathButton = requiredElement<HTMLButtonElement>(root, '[data-begin-next-breath]');
    const range = requiredElement<HTMLInputElement>(root, '[data-cycle-range]');
    const rangeOutput = requiredElement<HTMLElement>(root, '[data-range-output]');
    const stateLabel = requiredElement<HTMLElement>(root, '[data-state-label]');
    const statePosition = requiredElement<HTMLElement>(root, '[data-state-position]');
    const cycleCount = requiredElement<HTMLElement>(root, '[data-cycle-count]');
    const stateDetails = requiredElement<HTMLElement>(root, '[data-state-details]');
    const status = requiredElement<HTMLElement>(root, '[data-status]');
    const resetButton = requiredElement<HTMLButtonElement>(root, '[data-reset]');
    const returnButton = requiredElement<HTMLButtonElement>(root, '[data-return-overview]');
    const inventory = requiredElement<HTMLDetailsElement>(root, '[data-inventory]');
    const inventoryButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-select-state]'));
    const detailFields = {
      label: requiredElement<HTMLElement>(root, '[data-detail-label]'),
      phase: requiredElement<HTMLElement>(root, '[data-detail-phase]'),
      cycle: requiredElement<HTMLElement>(root, '[data-detail-cycle]'),
      phasePosition: requiredElement<HTMLElement>(root, '[data-detail-phase-position]'),
      previous: requiredElement<HTMLElement>(root, '[data-detail-previous]'),
      next: requiredElement<HTMLElement>(root, '[data-detail-next]'),
      boundary: requiredElement<HTMLElement>(root, '[data-detail-boundary]'),
      classification: requiredElement<HTMLElement>(root, '[data-detail-classification]'),
      approval: requiredElement<HTMLElement>(root, '[data-detail-approval]'),
    };

    let state: CosmicBreathCycleState = INITIAL_CYCLE_STATE;
    let settleTimeout: number | null = null;
    let activePointerId: number | null = null;
    let committedIndexBeforeDrag: number | null = null;
    let queuedDragPoint: NormalizedPoint | null = null;
    let dragAnimationFrame: number | null = null;

    const cancelPendingReveal = (): void => {
      if (settleTimeout !== null) window.clearTimeout(settleTimeout);
      settleTimeout = null;
    };

    const announce = (message: string): void => {
      status.textContent = message;
    };

    const markerTransform = (point: NormalizedPoint): string =>
      `translate(${point.x * 100} ${point.y * 64})`;

    const setMarkerPoint = (point: NormalizedPoint): void => {
      dragMarker.setAttribute('transform', markerTransform(point));
    };

    const pointFromPointer = (event: PointerEvent): NormalizedPoint => {
      const bounds = dragSurface.getBoundingClientRect();
      if (bounds.width <= 0 || bounds.height <= 0) {
        throw new RangeError('Cosmic Breath drag field must have visible dimensions');
      }
      return clampNormalizedPoint({
        x: (event.clientX - bounds.left) / bounds.width,
        y: (event.clientY - bounds.top) / bounds.height,
      });
    };

    const showStructuralPreview = (selected: StructuralTomState): void => {
      const summary = getStructuralStateSummary(selected);
      stateLabel.textContent = summary.label;
      statePosition.textContent = `${summary.phase} · cycle position ${summary.cyclePosition}`;
      rangeOutput.textContent = summary.cyclePosition;
    };

    const applyDragPoint = (point: NormalizedPoint): void => {
      if (state.mode !== 'dragging' || state.selectedIndex === null) return;
      const activePhase = getTomStateByIndex(state.selectedIndex).phase;
      const nearest = findNearestAnchorInPhase(point, activePhase);
      state = updateDragPreview(state, canonicalIndexForAnchor(nearest));
      setMarkerPoint(point);
      dragPreview.textContent = compactStructuralPreviewText(nearest);
      showStructuralPreview(getTomStateByIndex(nearest.canonicalIndex));
      stateDetails.hidden = true;
      dragSurface.dataset.previewIndex = String(nearest.canonicalIndex);
    };

    const cancelDragAnimationFrame = (): void => {
      if (dragAnimationFrame !== null) window.cancelAnimationFrame(dragAnimationFrame);
      dragAnimationFrame = null;
      queuedDragPoint = null;
    };

    const flushQueuedDragPoint = (): void => {
      dragAnimationFrame = null;
      const point = queuedDragPoint;
      queuedDragPoint = null;
      if (point !== null) applyDragPoint(point);
    };

    const queueDragPoint = (point: NormalizedPoint): void => {
      queuedDragPoint = point;
      if (dragAnimationFrame === null) {
        dragAnimationFrame = window.requestAnimationFrame(flushQueuedDragPoint);
      }
    };

    const stopPointerTracking = (): void => {
      cancelDragAnimationFrame();
      const pointerId = activePointerId;
      activePointerId = null;
      root.classList.remove('cycle-explorer--dragging');
      dragSurface.removeAttribute('data-dragging');
      if (pointerId !== null && dragSurface.hasPointerCapture?.(pointerId)) {
        dragSurface.releasePointerCapture(pointerId);
      }
    };

    const render = (): void => {
      const inOverview = state.mode === 'overview';
      overview.hidden = !inOverview;
      panel.hidden = inOverview;
      if (state.selectedIndex === null) {
        const openingAnchor = getDragAnchorByCanonicalIndex(0);
        showStructuralPreview(getTomStateByIndex(0));
        setMarkerPoint(openingAnchor.point);
        dragPreview.textContent = compactStructuralPreviewText(openingAnchor);
        dragSurface.dataset.activePhase = 'expansion';
        dragSurface.removeAttribute('data-preview-index');
        range.value = '0';
        cycleCount.textContent = 'Cosmic Breath sequence: 1';
        previousButton.disabled = false;
        nextButton.disabled = false;
        beginCompressionButton.hidden = true;
        beginNextBreathButton.hidden = true;
        stateDetails.hidden = true;
        Object.values(detailFields).forEach((field) => { field.textContent = ''; });
        inventoryButtons.forEach((button) => button.removeAttribute('aria-current'));
        return;
      }

      const selected = getTomStateByIndex(state.selectedIndex);
      const summary = getStructuralStateSummary(selected);
      const controlState = getExplorerControlState(selected);
      const selectedAnchor = getDragAnchorByCanonicalIndex(state.selectedIndex);
      showStructuralPreview(selected);
      setMarkerPoint(snappedMarkerCoordinates(state.selectedIndex));
      dragPreview.textContent = compactStructuralPreviewText(selectedAnchor);
      dragSurface.dataset.activePhase = selected.phase;
      dragSurface.removeAttribute('data-preview-index');
      cycleCount.textContent = `Cosmic Breath sequence: ${state.cycleCount + 1}`;
      range.value = String(state.selectedIndex);
      previousButton.disabled = controlState.previousDisabled;
      nextButton.disabled = controlState.nextDisabled;
      beginCompressionButton.hidden = !controlState.showBeginCompression;
      beginNextBreathButton.hidden = !controlState.showBeginNextBreath;

      detailFields.label.textContent = summary.label;
      detailFields.phase.textContent = summary.phase;
      detailFields.cycle.textContent = summary.cyclePosition;
      detailFields.phasePosition.textContent = summary.phasePosition;
      detailFields.previous.textContent = summary.previousState;
      detailFields.next.textContent = summary.nextState;
      detailFields.boundary.textContent = summary.boundaryRole;
      detailFields.classification.textContent = summary.classification;
      detailFields.approval.textContent = summary.approvalStatus;
      stateDetails.hidden = state.mode !== 'details';

      inventoryButtons.forEach((button, index) => {
        if (index === state.selectedIndex) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
    };

    const scheduleSettledDetails = (
      selected: StructuralTomState,
      statusKind: SelectionStatusKind,
      initialAnnouncement = getSelectionStatusText(statusKind, selected),
    ): void => {
      const token = state.pendingSettleToken;
      render();
      announce(initialAnnouncement);
      if (token === null) return;

      settleTimeout = window.setTimeout(() => {
        const completed = completeSettling(state, token);
        const revealed = revealSettledDetails(completed, token);
        if (revealed === state) return;
        state = revealed;
        settleTimeout = null;
        render();
        announce(getSelectionStatusText('settled', selected));
      }, 200);
    };

    const settleSelection = (
      selectedState: CosmicBreathCycleState,
      statusKind: SelectionStatusKind,
    ): void => {
      cancelPendingReveal();
      stopPointerTracking();
      committedIndexBeforeDrag = null;
      const selectedIndex = selectedState.selectedIndex;
      if (selectedIndex === null) return;
      state = releaseDragIntoSettling(beginDragging(selectedState), selectedIndex);
      scheduleSettledDetails(getTomStateByIndex(selectedIndex), statusKind);
    };

    const cancelActiveDrag = (announceCancellation = true): boolean => {
      if (activePointerId === null) return false;
      const restoreIndex = committedIndexBeforeDrag ?? state.selectedIndex;
      stopPointerTracking();
      committedIndexBeforeDrag = null;
      if (restoreIndex !== null) state = selectStateByIndex(state, restoreIndex);
      render();
      if (announceCancellation) announce('Drag cancelled. The last committed structural state was restored.');
      return true;
    };

    const selectDirectly = (index: number): void => {
      const base = state.mode === 'overview' ? enterExploration(state) : state;
      settleSelection(selectStateByIndex(base, index), 'direct');
    };

    const restoreOverview = (useReset: boolean): void => {
      cancelPendingReveal();
      stopPointerTracking();
      committedIndexBeforeDrag = null;
      state = useReset ? resetCycleExplorer(state) : returnToOverview(state);
      inventory.open = false;
      render();
      announce('Returned to the original five-shell overview.');
      exploreButton.focus();
    };

    exploreButton.disabled = false;
    exploreButton.setAttribute('aria-disabled', 'false');
    availability.hidden = true;
    range.disabled = false;
    inventoryButtons.forEach((button) => { button.disabled = false; });

    dragSurface.addEventListener('pointerdown', (event) => {
      if (
        activePointerId !== null
        || !event.isPrimary
        || (event.pointerType === 'mouse' && event.button !== 0)
        || state.mode === 'overview'
        || state.selectedIndex === null
      ) return;

      event.preventDefault();
      cancelPendingReveal();
      committedIndexBeforeDrag = state.selectedIndex;
      state = beginDragging(state);
      activePointerId = event.pointerId;
      root.classList.add('cycle-explorer--dragging');
      dragSurface.setAttribute('data-dragging', 'true');
      try {
        dragSurface.setPointerCapture?.(event.pointerId);
      } catch {
        // Pointer capture is an enhancement; active-pointer checks still protect the drag.
      }
      stateDetails.hidden = true;
      queueDragPoint(pointFromPointer(event));
      announce(`Drag started from ${getTomStateByIndex(committedIndexBeforeDrag).label}.`);
    });

    dragSurface.addEventListener('pointermove', (event) => {
      if (event.pointerId !== activePointerId || !event.isPrimary) return;
      event.preventDefault();
      queueDragPoint(pointFromPointer(event));
    });

    dragSurface.addEventListener('pointerup', (event) => {
      if (event.pointerId !== activePointerId || !event.isPrimary || state.mode !== 'dragging') return;
      event.preventDefault();
      cancelDragAnimationFrame();
      applyDragPoint(pointFromPointer(event));
      const committedIndex = state.previewIndex ?? committedIndexBeforeDrag;
      if (committedIndex === null) {
        cancelActiveDrag();
        return;
      }
      const anchor = getDragAnchorByCanonicalIndex(committedIndex);
      state = releaseDragIntoSettling(state, committedIndex);
      stopPointerTracking();
      committedIndexBeforeDrag = null;
      scheduleSettledDetails(
        getTomStateByIndex(committedIndex),
        'settling',
        `Snapped to ${compactStructuralPreviewText(anchor)}. Settling.`,
      );
    });

    dragSurface.addEventListener('pointercancel', (event) => {
      if (event.pointerId !== activePointerId) return;
      cancelActiveDrag();
    });

    dragSurface.addEventListener('lostpointercapture', (event) => {
      if (event.pointerId !== activePointerId) return;
      cancelActiveDrag();
    });

    exploreButton.addEventListener('click', () => {
      settleSelection(enterExploration(state), 'settling');
      panel.focus({ preventScroll: true });
    });
    previousButton.addEventListener('click', () => {
      settleSelection(moveToPreviousState(state), 'sequential');
    });
    nextButton.addEventListener('click', () => {
      settleSelection(moveToNextState(state), 'sequential');
    });
    beginCompressionButton.addEventListener('click', () => {
      settleSelection(continueFromAtom(state), 'sequential');
    });
    beginNextBreathButton.addEventListener('click', () => {
      settleSelection(beginNextCosmicBreath(state), 'sequential');
    });
    resetButton.addEventListener('click', () => restoreOverview(true));
    returnButton.addEventListener('click', () => restoreOverview(false));

    range.addEventListener('input', () => {
      cancelPendingReveal();
      cancelActiveDrag(false);
      if (state.selectedIndex !== null && state.mode !== 'dragging') state = beginDragging(state);
      const index = parseStructuralIndex(range.value);
      const preview = getTomStateByIndex(index);
      showStructuralPreview(preview);
      stateDetails.hidden = true;
      announce(`Previewing ${preview.label}, ${preview.phase} state ${preview.phaseIndex}.`);
    });
    range.addEventListener('change', () => {
      selectDirectly(parseStructuralIndex(range.value));
    });

    inventoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = parseStructuralIndex(button.dataset.stateIndex ?? '');
        selectDirectly(index);
      });
    });

    root.addEventListener('keydown', (event) => {
      const target = event.target instanceof HTMLElement ? event.target : null;
      if (isEditableControl(target)) return;
      const command = getExplorerKeyboardCommand(event.key);
      if (command === null) return;
      if (command === 'return-overview') {
        if (state.mode !== 'overview') {
          event.preventDefault();
          restoreOverview(false);
        }
        return;
      }
      if (state.mode === 'overview' || state.selectedIndex === null) return;

      event.preventDefault();
      const selected = getTomStateByIndex(state.selectedIndex);
      if (command === 'previous') {
        settleSelection(moveToPreviousState(state), 'sequential');
      } else if (command === 'next') {
        settleSelection(moveToNextState(state), 'sequential');
      } else if (command === 'first') {
        selectDirectly(0);
      } else if (command === 'last') {
        selectDirectly(orderedTomStates.length - 1);
      } else {
        const bounds = getPhaseBoundaryIndices(selected.phase);
        selectDirectly(command === 'phase-start' ? bounds.start : bounds.end);
      }
    });

    render();
  };

  document.querySelectorAll<HTMLElement>('[data-cosmic-breath-explorer]').forEach(initializeExplorer);
</script>

