---
import ClassificationBadge from './ClassificationBadge.astro';
---

<section
  class="cu-time-converter"
  aria-labelledby="cu-time-converter-title"
>
  <div class="cu-time-converter__header">
    <p class="cu-time-converter__eyebrow">CU-Time Tool</p>

    <h2 id="cu-time-converter-title">
      CU-Time Converter
    </h2>

    <ClassificationBadge
      classification="cu-mathematical-model"
    />
  </div>

  <div class="cu-time-converter__content">
    <p>
      Interactive converter under development.
    </p>

    <p>
      The computational implementation will follow documented definitions,
      constants, assumptions, and validation criteria.
    </p>

    <p>
      Future versions will describe inputs, outputs, conversion methods,
      uncertainty handling, and the relationship between CU-Time notation
      and conventional chronology.
    </p>
  </div>

  <div
    class="cu-time-converter__status"
    aria-label="Converter development status"
  >
    <span class="cu-time-converter__status-marker" aria-hidden="true">
      ◇
    </span>

    <span>
      Research status: Active development
    </span>
  </div>
</section>

<style>
  .cu-time-converter {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding: var(--space-8);
    border: 1px solid var(--color-translucent-blue);
    background: var(--color-surface-translucent);
  }

  .cu-time-converter__header {
    display: grid;
    gap: var(--space-4);
  }

  .cu-time-converter__eyebrow {
    margin: 0;
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--color-white-gold);
    font-family: var(--font-family-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .cu-time-converter__content {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-readable);
  }

  .cu-time-converter__content p {
    margin: 0;
    color: var(--color-text);
  }

  .cu-time-converter__status {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-amber);
    color: var(--color-amber);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cu-time-converter__status-marker {
    color: var(--color-amber);
  }
</style>