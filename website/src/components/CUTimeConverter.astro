---
import ClassificationBadge from './ClassificationBadge.astro';
---

<section class="cu-time-converter" aria-labelledby="cu-time-converter-title">
  <div class="cu-time-converter__header">
    <p class="cu-time-converter__eyebrow">CU-Time Tool</p>
    <h2 id="cu-time-converter-title">Gregorian UTC and CU-Time converter</h2>
    <ClassificationBadge classification="cu-mathematical-model" />
  </div>

  <p class="cu-time-converter__intro">
    Convert a validated proleptic Gregorian UTC date to CU-Time, or locate the
    civil CE/BCE date corresponding to a converter-aligned CU-Time value.
  </p>

  <div class="cu-time-converter__directions">
    <section class="cu-time-direction" aria-labelledby="gregorian-to-cu-title">
    <div class="cu-time-direction__header">
      <p class="cu-time-direction__label">Forward conversion</p>
      <h3 id="gregorian-to-cu-title">Gregorian UTC to CU-Time</h3>
      <p>Enter a civil date to calculate its exact converter-aligned coordinate.</p>
    </div>
    <form class="cu-time-form" data-gregorian-form novalidate>
      <fieldset>
        <legend>Date</legend>
        <div class="cu-time-form__date-grid">
          <div class="cu-time-form__field">
            <label for="gregorian-month">Month</label>
            <input id="gregorian-month" name="month" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" required data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-day">Day</label>
            <input id="gregorian-day" name="day" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" required data-gregorian-field />
          </div>
          <div class="cu-time-form__field cu-time-form__field--year">
            <label for="gregorian-year">Civil year</label>
            <input id="gregorian-year" name="civilYear" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" required data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-era">Era</label>
            <select id="gregorian-era" name="era" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" data-gregorian-field>
              <option value="CE">CE</option>
              <option value="BCE">BCE</option>
            </select>
          </div>
        </div>
        <p id="gregorian-date-hint" class="cu-time-form__hint">
          Enter month, day, and a civil year from 1 through 9999999999999.
        </p>
      </fieldset>

      <fieldset>
        <legend>Time (UTC)</legend>
        <div class="cu-time-form__time-grid">
          <div class="cu-time-form__field">
            <label for="gregorian-hour">Hour</label>
            <input id="gregorian-hour" name="hour" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-time-hint gregorian-error" aria-invalid="false" data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-minute">Minute</label>
            <input id="gregorian-minute" name="minute" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-time-hint gregorian-error" aria-invalid="false" data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-second">Second</label>
            <input id="gregorian-second" name="second" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-time-hint gregorian-error" aria-invalid="false" data-gregorian-field />
          </div>
        </div>
        <p id="gregorian-time-hint" class="cu-time-form__hint">
          Leave all three fields empty for midnight, or supply all three together.
        </p>
      </fieldset>

      <p id="gregorian-error" class="cu-time-form__error" role="alert" aria-live="assertive" hidden data-gregorian-error></p>
      <button type="submit">Convert Gregorian UTC</button>
    </form>

    <section class="cu-time-result" aria-labelledby="gregorian-result-title" aria-live="polite" tabindex="-1" hidden data-gregorian-result>
      <div class="cu-time-result__header">
        <div>
          <p class="cu-time-result__status">Conversion complete</p>
          <h3 id="gregorian-result-title">CU-Time result</h3>
        </div>
        <button class="cu-time-result__copy" type="button" data-copy-button data-copy-source="gregorian-cu-time" aria-describedby="gregorian-copy-status">
          Copy exact value
        </button>
      </div>
      <dl class="cu-time-result__grid">
        <div class="cu-time-result__item cu-time-result__item--context">
          <dt>Input instant</dt>
          <dd data-gregorian-result-input></dd>
        </div>
        <div class="cu-time-result__item cu-time-result__item--primary">
          <dt>Exact CU-Time</dt>
          <dd class="cu-time-result__number" data-gregorian-result-cu-time data-copy-value="gregorian-cu-time"></dd>
          <p class="cu-time-result__note">Fixed-point decimal · no digits hidden</p>
        </div>
        <div class="cu-time-result__item">
          <dt>Scientific notation</dt>
          <dd class="cu-time-result__number" data-gregorian-result-exponential></dd>
        </div>
      </dl>
      <section class="cu-time-result__reference" aria-labelledby="gregorian-reference-title">
        <h4 id="gregorian-reference-title">Observable-Universe Reference</h4>
        <dl class="cu-time-result__reference-grid">
          <div class="cu-time-result__item">
            <dt>Observable-Universe–Aligned CU Coordinate</dt>
            <dd class="cu-time-result__number" data-gregorian-reference-coordinate></dd>
            <p class="cu-time-result__note" data-gregorian-reference-coordinate-exponential></p>
          </div>
          <div class="cu-time-result__item">
            <dt data-gregorian-reference-age-label>Derived Age Since the Big Bang</dt>
            <dd class="cu-time-result__number" data-gregorian-reference-age-value></dd>
            <p class="cu-time-result__note" data-gregorian-reference-age-message></p>
          </div>
          <div class="cu-time-result__item">
            <dt>CU Coordinate-to-Observable-Age Ratio</dt>
            <dd class="cu-time-result__number" data-gregorian-reference-ratio-value></dd>
            <p class="cu-time-result__note" data-gregorian-reference-ratio-message></p>
          </div>
        </dl>
        <details data-gregorian-reference-details>
          <summary>Method and precision details</summary>
          <p>
            The aligned coordinate and derived age use the converter’s deterministic model arithmetic.
            Computational precision, calendar/model precision, and empirical uncertainty are distinct.
          </p>
          <p data-gregorian-reference-ratio-exact-row hidden>
            Exact ratio: <span class="cu-time-result__number" data-gregorian-reference-ratio-exact></span>
          </p>
        </details>
      </section>
      <p id="gregorian-copy-status" class="cu-time-result__copy-status" role="status" aria-live="polite" data-copy-status="gregorian-cu-time"></p>
    </section>
    </section>

    <section class="cu-time-direction" aria-labelledby="cu-to-gregorian-title">
    <div class="cu-time-direction__header">
      <p class="cu-time-direction__label">Reverse conversion</p>
      <h3 id="cu-to-gregorian-title">CU-Time to Gregorian UTC</h3>
      <p>Locate the civil UTC instant represented by an exact CU-Time coordinate.</p>
    </div>
    <form class="cu-time-form" data-cu-time-form novalidate>
    <div class="cu-time-form__field">
      <label for="cu-time-input">CU-Time</label>
      <p id="cu-time-input-hint" class="cu-time-form__hint">
        Use a plain decimal number, such as 3094134044923.50975356477292230250881.
        Scientific notation is not accepted.
      </p>
      <input
        id="cu-time-input"
        name="cuTime"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="cu-time-input-hint cu-time-error"
        aria-invalid="false"
        required
        data-cu-time-input
      />
    </div>

    <p
      id="cu-time-error"
      class="cu-time-form__error"
      role="alert"
      aria-live="assertive"
      hidden
      data-cu-time-error
    ></p>

    <button type="submit">Convert CU-Time</button>
    </form>

    <section
      class="cu-time-result"
      aria-labelledby="cu-time-result-title"
      aria-live="polite"
      tabindex="-1"
      hidden
      data-cu-time-result
    >
      <div class="cu-time-result__header">
        <div>
          <p class="cu-time-result__status">Conversion complete</p>
          <h3 id="cu-time-result-title">Gregorian UTC result</h3>
        </div>
        <button class="cu-time-result__copy" type="button" data-copy-button data-copy-source="reverse-gregorian" aria-describedby="reverse-copy-status">
          Copy date and time
        </button>
      </div>
      <dl class="cu-time-result__grid">
        <div class="cu-time-result__item cu-time-result__item--context">
          <dt>Input CU-Time</dt>
          <dd class="cu-time-result__number" data-cu-time-result-input></dd>
        </div>
        <div class="cu-time-result__item">
          <dt>Scientific notation</dt>
          <dd class="cu-time-result__number" data-cu-time-result-exponential></dd>
        </div>
        <div class="cu-time-result__item cu-time-result__item--primary">
          <dt>Corresponding Gregorian instant</dt>
          <dd data-cu-time-result-gregorian data-copy-value="reverse-gregorian"></dd>
          <p class="cu-time-result__note">Proleptic Gregorian calendar · UTC</p>
        </div>
      </dl>
      <section class="cu-time-result__reference" aria-labelledby="reverse-reference-title">
        <h4 id="reverse-reference-title">Observable-Universe Reference</h4>
        <dl class="cu-time-result__reference-grid">
          <div class="cu-time-result__item">
            <dt>Observable-Universe–Aligned CU Coordinate</dt>
            <dd class="cu-time-result__number" data-reverse-reference-coordinate></dd>
            <p class="cu-time-result__note" data-reverse-reference-coordinate-exponential></p>
          </div>
          <div class="cu-time-result__item">
            <dt data-reverse-reference-age-label>Derived Age Since the Big Bang</dt>
            <dd class="cu-time-result__number" data-reverse-reference-age-value></dd>
            <p class="cu-time-result__note" data-reverse-reference-age-message></p>
          </div>
          <div class="cu-time-result__item">
            <dt>CU Coordinate-to-Observable-Age Ratio</dt>
            <dd class="cu-time-result__number" data-reverse-reference-ratio-value></dd>
            <p class="cu-time-result__note" data-reverse-reference-ratio-message></p>
          </div>
        </dl>
        <details data-reverse-reference-details>
          <summary>Method and precision details</summary>
          <p>
            The aligned coordinate and derived age use the converter’s deterministic model arithmetic.
            Computational precision, calendar/model precision, and empirical uncertainty are distinct.
          </p>
          <p data-reverse-reference-ratio-exact-row hidden>
            Exact ratio: <span class="cu-time-result__number" data-reverse-reference-ratio-exact></span>
          </p>
        </details>
      </section>
      <p id="reverse-copy-status" class="cu-time-result__copy-status" role="status" aria-live="polite" data-copy-status="reverse-gregorian"></p>
    </section>
    </section>
  </div>

  <p class="cu-time-converter__methodology">
    This converter uses a proleptic Gregorian calendar with no reform cutover.
    Public civil year zero is not used; astronomical year zero is displayed as 1 BCE.
  </p>
</section>

<script>
  import { convertCuTimeForDisplay, convertGregorianForDisplay } from '../lib/cuTime';

  const gregorianForm = document.querySelector<HTMLFormElement>('[data-gregorian-form]');
  const gregorianFields = Array.from(document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-gregorian-field]'));
  const gregorianError = document.querySelector<HTMLElement>('[data-gregorian-error]');
  const gregorianResult = document.querySelector<HTMLElement>('[data-gregorian-result]');
  const gregorianResultInput = document.querySelector<HTMLElement>('[data-gregorian-result-input]');
  const gregorianResultCuTime = document.querySelector<HTMLElement>('[data-gregorian-result-cu-time]');
  const gregorianResultExponential = document.querySelector<HTMLElement>('[data-gregorian-result-exponential]');

  interface ObservableReferenceElements {
    coordinate: HTMLElement | null;
    coordinateExponential: HTMLElement | null;
    ageLabel: HTMLElement | null;
    ageValue: HTMLElement | null;
    ageMessage: HTMLElement | null;
    ratioValue: HTMLElement | null;
    ratioMessage: HTMLElement | null;
    ratioExact: HTMLElement | null;
    ratioExactRow: HTMLElement | null;
    details: HTMLDetailsElement | null;
  }

  function renderObservableUniverseReference(
    reference: {
      observableUniverseAlignedCuCoordinate: string;
      observableUniverseAlignedCuCoordinateExponential: string;
      observableAge: { kind: string; label: string; years?: string; intervalYears?: string; message?: string };
      coordinateToObservableAgeRatio: { kind: string; summary?: string; exact?: string; message?: string };
    },
    elements: ObservableReferenceElements,
  ) {
    if (!elements.coordinate || !elements.coordinateExponential || !elements.ageLabel || !elements.ageValue
      || !elements.ageMessage || !elements.ratioValue || !elements.ratioMessage || !elements.ratioExact
      || !elements.ratioExactRow || !elements.details) return;

    elements.coordinate.textContent = reference.observableUniverseAlignedCuCoordinate;
    elements.coordinateExponential.textContent = `Scientific notation: ${reference.observableUniverseAlignedCuCoordinateExponential}`;
    elements.ageLabel.textContent = reference.observableAge.label;
    elements.ageValue.textContent = reference.observableAge.kind === 'elapsed'
      ? `${reference.observableAge.years} years`
      : reference.observableAge.kind === 'pre-big-bang-reference-interval'
        ? `${reference.observableAge.intervalYears} years`
        : '';
    elements.ageMessage.textContent = reference.observableAge.message ?? '';
    elements.ratioValue.textContent = reference.coordinateToObservableAgeRatio.kind === 'available'
      ? reference.coordinateToObservableAgeRatio.summary ?? ''
      : '';
    elements.ratioMessage.textContent = reference.coordinateToObservableAgeRatio.message ?? '';
    elements.ratioExact.textContent = reference.coordinateToObservableAgeRatio.exact ?? '';
    elements.ratioExactRow.hidden = reference.coordinateToObservableAgeRatio.kind !== 'available';
    elements.details.open = false;
  }

  const gregorianReference: ObservableReferenceElements = {
    coordinate: document.querySelector<HTMLElement>('[data-gregorian-reference-coordinate]'),
    coordinateExponential: document.querySelector<HTMLElement>('[data-gregorian-reference-coordinate-exponential]'),
    ageLabel: document.querySelector<HTMLElement>('[data-gregorian-reference-age-label]'),
    ageValue: document.querySelector<HTMLElement>('[data-gregorian-reference-age-value]'),
    ageMessage: document.querySelector<HTMLElement>('[data-gregorian-reference-age-message]'),
    ratioValue: document.querySelector<HTMLElement>('[data-gregorian-reference-ratio-value]'),
    ratioMessage: document.querySelector<HTMLElement>('[data-gregorian-reference-ratio-message]'),
    ratioExact: document.querySelector<HTMLElement>('[data-gregorian-reference-ratio-exact]'),
    ratioExactRow: document.querySelector<HTMLElement>('[data-gregorian-reference-ratio-exact-row]'),
    details: document.querySelector<HTMLDetailsElement>('[data-gregorian-reference-details]'),
  };

  const clearCopyStatus = (source: string) => {
    const status = document.querySelector<HTMLElement>(`[data-copy-status="${source}"]`);
    if (status) status.textContent = '';
  };

  if (gregorianForm && gregorianError && gregorianResult && gregorianResultInput && gregorianResultCuTime && gregorianResultExponential) {
    const clearGregorianError = () => {
      gregorianError.hidden = true;
      gregorianError.textContent = '';
      gregorianFields.forEach((field) => field.setAttribute('aria-invalid', 'false'));
    };

    gregorianFields.forEach((field) => {
      field.addEventListener('input', clearGregorianError);
      field.addEventListener('change', clearGregorianError);
    });
    gregorianForm.addEventListener('submit', (event) => {
      event.preventDefault();
      clearGregorianError();
      clearCopyStatus('gregorian-cu-time');

      const data = new FormData(gregorianForm);
      const converted = convertGregorianForDisplay({
        civilYear: String(data.get('civilYear') ?? ''),
        era: String(data.get('era') ?? ''),
        month: String(data.get('month') ?? ''),
        day: String(data.get('day') ?? ''),
        hour: String(data.get('hour') ?? ''),
        minute: String(data.get('minute') ?? ''),
        second: String(data.get('second') ?? ''),
      });

      if (!converted.ok) {
        const requestedField = converted.error.field === 'time' ? 'hour' : converted.error.field;
        const field = gregorianFields.find((candidate) => candidate.name === requestedField) ?? gregorianFields[0];
        field?.setAttribute('aria-invalid', 'true');
        gregorianError.textContent = converted.error.message;
        gregorianError.hidden = false;
        gregorianResult.hidden = true;
        field?.focus();
        return;
      }

      gregorianResultInput.textContent = converted.value.gregorianUtc;
      gregorianResultCuTime.textContent = converted.value.cuTime;
      gregorianResultExponential.textContent = converted.value.cuTimeExponential;
      renderObservableUniverseReference(converted.value.observableUniverseReference, gregorianReference);
      gregorianResult.hidden = false;
      gregorianResult.focus();
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-cu-time-form]');
  const input = document.querySelector<HTMLInputElement>('[data-cu-time-input]');
  const error = document.querySelector<HTMLElement>('[data-cu-time-error]');
  const result = document.querySelector<HTMLElement>('[data-cu-time-result]');
  const resultInput = document.querySelector<HTMLElement>('[data-cu-time-result-input]');
  const resultExponential = document.querySelector<HTMLElement>('[data-cu-time-result-exponential]');
  const resultGregorian = document.querySelector<HTMLElement>('[data-cu-time-result-gregorian]');
  const reverseReference: ObservableReferenceElements = {
    coordinate: document.querySelector<HTMLElement>('[data-reverse-reference-coordinate]'),
    coordinateExponential: document.querySelector<HTMLElement>('[data-reverse-reference-coordinate-exponential]'),
    ageLabel: document.querySelector<HTMLElement>('[data-reverse-reference-age-label]'),
    ageValue: document.querySelector<HTMLElement>('[data-reverse-reference-age-value]'),
    ageMessage: document.querySelector<HTMLElement>('[data-reverse-reference-age-message]'),
    ratioValue: document.querySelector<HTMLElement>('[data-reverse-reference-ratio-value]'),
    ratioMessage: document.querySelector<HTMLElement>('[data-reverse-reference-ratio-message]'),
    ratioExact: document.querySelector<HTMLElement>('[data-reverse-reference-ratio-exact]'),
    ratioExactRow: document.querySelector<HTMLElement>('[data-reverse-reference-ratio-exact-row]'),
    details: document.querySelector<HTMLDetailsElement>('[data-reverse-reference-details]'),
  };

  if (form && input && error && result && resultInput && resultExponential && resultGregorian) {
    const clearError = () => {
      error.hidden = true;
      error.textContent = '';
      input.setAttribute('aria-invalid', 'false');
    };

    input.addEventListener('input', clearError);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearError();
      clearCopyStatus('reverse-gregorian');

      const converted = convertCuTimeForDisplay(input.value);
      if (!converted.ok) {
        input.setAttribute('aria-invalid', 'true');
        error.textContent = converted.error.message;
        error.hidden = false;
        result.hidden = true;
        input.focus();
        return;
      }

      resultInput.textContent = converted.value.inputCuTime;
      resultExponential.textContent = converted.value.inputCuTimeExponential;
      resultGregorian.textContent = converted.value.gregorianUtc;
      renderObservableUniverseReference(converted.value.observableUniverseReference, reverseReference);
      result.hidden = false;
      result.focus();
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach((button) => {
    button.addEventListener('click', async () => {
      const source = button.dataset.copySource;
      const value = source
        ? document.querySelector<HTMLElement>(`[data-copy-value="${source}"]`)
        : null;
      const status = source
        ? document.querySelector<HTMLElement>(`[data-copy-status="${source}"]`)
        : null;

      if (!value?.textContent || !status) return;

      try {
        await navigator.clipboard.writeText(value.textContent);
        status.textContent = 'Copied to clipboard.';
      } catch {
        status.textContent = 'Copy failed. Select and copy the value manually.';
      }
    });
  });
</script>

<style>
  .cu-time-converter {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding: var(--space-8);
    border: 1px solid var(--color-translucent-blue);
    background: var(--color-surface-translucent);
  }

  .cu-time-converter__header,
  .cu-time-converter__directions,
  .cu-time-direction,
  .cu-time-direction__header,
  .cu-time-form,
  .cu-time-form__field,
  .cu-time-result,
  .cu-time-result__reference,
  .cu-time-result dl {
    display: grid;
    gap: var(--space-4);
  }

  .cu-time-converter__eyebrow,
  .cu-time-direction__label,
  .cu-time-direction__header p,
  .cu-time-converter__intro,
  .cu-time-converter__methodology,
  .cu-time-form__hint,
  .cu-time-form__error,
  .cu-time-result h3,
  .cu-time-result h4,
  .cu-time-result dl,
  .cu-time-result dd {
    margin: 0;
  }

  .cu-time-converter__directions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .cu-time-direction {
    min-width: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-translucent-blue);
    background: rgb(6 11 23 / 72%);
  }

  .cu-time-direction__label,
  .cu-time-result__status {
    color: var(--color-amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cu-time-direction__header p:last-child {
    color: var(--color-text-muted);
  }

  .cu-time-converter__eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    color: var(--color-white-gold);
    font-family: var(--font-family-serif);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  h3 {
    font-size: 1.35rem;
  }

  .cu-time-converter__intro,
  .cu-time-converter__methodology,
  .cu-time-form {
    max-width: var(--measure-readable);
  }

  .cu-time-form label,
  .cu-time-form legend,
  .cu-time-result dt {
    color: var(--color-white-gold);
    font-weight: 700;
  }

  .cu-time-form__hint,
  .cu-time-converter__methodology {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .cu-time-form fieldset {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cu-time-form__date-grid,
  .cu-time-form__time-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .cu-time-form__date-grid {
    grid-template-columns: minmax(5rem, 0.7fr) minmax(5rem, 0.7fr) minmax(10rem, 1.6fr) minmax(5rem, 0.7fr);
  }

  .cu-time-form input,
  .cu-time-form select {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-translucent-blue);
    border-radius: 0;
    background: var(--color-background);
    color: var(--color-text);
    font: inherit;
  }

  .cu-time-form input:hover,
  .cu-time-form select:hover {
