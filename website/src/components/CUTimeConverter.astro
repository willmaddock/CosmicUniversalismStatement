---
import ClassificationBadge from './ClassificationBadge.astro';
---

<section class="cu-time-converter" aria-labelledby="cu-time-converter-title">
  <div class="cu-time-converter__header">
    <p class="cu-time-converter__eyebrow">CU-Time Tool</p>
    <h2 id="cu-time-converter-title">Gregorian UTC and CU-Time converter</h2>
    <ClassificationBadge classification="cu-mathematical-model" />
  </div>

  <p class="cu-time-converter__intro">
    Convert a validated proleptic Gregorian UTC date to CU-Time, or locate the
    civil CE/BCE date corresponding to a converter-aligned CU-Time value.
  </p>

  <section class="cu-time-direction" aria-labelledby="gregorian-to-cu-title">
    <h3 id="gregorian-to-cu-title">Gregorian UTC to CU-Time</h3>
    <form class="cu-time-form" data-gregorian-form novalidate>
      <fieldset>
        <legend>Date</legend>
        <div class="cu-time-form__date-grid">
          <div class="cu-time-form__field">
            <label for="gregorian-month">Month</label>
            <input id="gregorian-month" name="month" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" required data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-day">Day</label>
            <input id="gregorian-day" name="day" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" required data-gregorian-field />
          </div>
          <div class="cu-time-form__field cu-time-form__field--year">
            <label for="gregorian-year">Civil year</label>
            <input id="gregorian-year" name="civilYear" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" required data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-era">Era</label>
            <select id="gregorian-era" name="era" aria-describedby="gregorian-date-hint gregorian-error" aria-invalid="false" data-gregorian-field>
              <option value="CE">CE</option>
              <option value="BCE">BCE</option>
            </select>
          </div>
        </div>
        <p id="gregorian-date-hint" class="cu-time-form__hint">
          Enter month, day, and a civil year from 1 through 9999999999999.
        </p>
      </fieldset>

      <fieldset>
        <legend>Time (UTC)</legend>
        <div class="cu-time-form__time-grid">
          <div class="cu-time-form__field">
            <label for="gregorian-hour">Hour</label>
            <input id="gregorian-hour" name="hour" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-time-hint gregorian-error" aria-invalid="false" data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-minute">Minute</label>
            <input id="gregorian-minute" name="minute" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-time-hint gregorian-error" aria-invalid="false" data-gregorian-field />
          </div>
          <div class="cu-time-form__field">
            <label for="gregorian-second">Second</label>
            <input id="gregorian-second" name="second" type="text" inputmode="numeric" autocomplete="off" aria-describedby="gregorian-time-hint gregorian-error" aria-invalid="false" data-gregorian-field />
          </div>
        </div>
        <p id="gregorian-time-hint" class="cu-time-form__hint">
          Leave all three fields empty for midnight, or supply all three together.
        </p>
      </fieldset>

      <p id="gregorian-error" class="cu-time-form__error" role="alert" aria-live="assertive" hidden data-gregorian-error></p>
      <button type="submit">Convert Gregorian UTC</button>
    </form>

    <section class="cu-time-result" aria-labelledby="gregorian-result-title" aria-live="polite" tabindex="-1" hidden data-gregorian-result>
      <h3 id="gregorian-result-title">Conversion result</h3>
      <dl>
        <div>
          <dt>Gregorian date and time</dt>
          <dd data-gregorian-result-input></dd>
        </div>
        <div>
          <dt>CU-Time</dt>
          <dd data-gregorian-result-cu-time></dd>
        </div>
      </dl>
    </section>
  </section>

  <section class="cu-time-direction" aria-labelledby="cu-to-gregorian-title">
    <h3 id="cu-to-gregorian-title">CU-Time to Gregorian UTC</h3>
    <form class="cu-time-form" data-cu-time-form novalidate>
    <div class="cu-time-form__field">
      <label for="cu-time-input">CU-Time</label>
      <p id="cu-time-input-hint" class="cu-time-form__hint">
        Use a plain decimal number, such as 3094134044923.50975356477292230250881.
        Scientific notation is not accepted.
      </p>
      <input
        id="cu-time-input"
        name="cuTime"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="cu-time-input-hint cu-time-error"
        aria-invalid="false"
        required
        data-cu-time-input
      />
    </div>

    <p
      id="cu-time-error"
      class="cu-time-form__error"
      role="alert"
      aria-live="assertive"
      hidden
      data-cu-time-error
    ></p>

    <button type="submit">Convert CU-Time</button>
    </form>

    <section
      class="cu-time-result"
      aria-labelledby="cu-time-result-title"
      aria-live="polite"
      tabindex="-1"
      hidden
      data-cu-time-result
    >
      <h3 id="cu-time-result-title">Conversion result</h3>
      <dl>
        <div>
          <dt>CU-Time</dt>
          <dd data-cu-time-result-input></dd>
        </div>
        <div>
          <dt>Gregorian date and time</dt>
          <dd data-cu-time-result-gregorian></dd>
        </div>
      </dl>
    </section>
  </section>

  <p class="cu-time-converter__methodology">
    This converter uses a proleptic Gregorian calendar with no reform cutover.
    Public civil year zero is not used; astronomical year zero is displayed as 1 BCE.
  </p>
</section>

<script>
  import { convertCuTimeForDisplay, convertGregorianForDisplay } from '../lib/cuTime';

  const gregorianForm = document.querySelector<HTMLFormElement>('[data-gregorian-form]');
  const gregorianFields = Array.from(document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-gregorian-field]'));
  const gregorianError = document.querySelector<HTMLElement>('[data-gregorian-error]');
  const gregorianResult = document.querySelector<HTMLElement>('[data-gregorian-result]');
  const gregorianResultInput = document.querySelector<HTMLElement>('[data-gregorian-result-input]');
  const gregorianResultCuTime = document.querySelector<HTMLElement>('[data-gregorian-result-cu-time]');

  if (gregorianForm && gregorianError && gregorianResult && gregorianResultInput && gregorianResultCuTime) {
    const clearGregorianError = () => {
      gregorianError.hidden = true;
      gregorianError.textContent = '';
      gregorianFields.forEach((field) => field.setAttribute('aria-invalid', 'false'));
    };

    gregorianFields.forEach((field) => {
      field.addEventListener('input', clearGregorianError);
      field.addEventListener('change', clearGregorianError);
    });
    gregorianForm.addEventListener('submit', (event) => {
      event.preventDefault();
      clearGregorianError();

      const data = new FormData(gregorianForm);
      const converted = convertGregorianForDisplay({
        civilYear: String(data.get('civilYear') ?? ''),
        era: String(data.get('era') ?? ''),
        month: String(data.get('month') ?? ''),
        day: String(data.get('day') ?? ''),
        hour: String(data.get('hour') ?? ''),
        minute: String(data.get('minute') ?? ''),
        second: String(data.get('second') ?? ''),
      });

      if (!converted.ok) {
        const requestedField = converted.error.field === 'time' ? 'hour' : converted.error.field;
        const field = gregorianFields.find((candidate) => candidate.name === requestedField) ?? gregorianFields[0];
        field?.setAttribute('aria-invalid', 'true');
        gregorianError.textContent = converted.error.message;
        gregorianError.hidden = false;
        gregorianResult.hidden = true;
        field?.focus();
        return;
      }

      gregorianResultInput.textContent = converted.value.gregorianUtc;
      gregorianResultCuTime.textContent = converted.value.cuTime;
      gregorianResult.hidden = false;
      gregorianResult.focus();
    });
  }

  const form = document.querySelector<HTMLFormElement>('[data-cu-time-form]');
  const input = document.querySelector<HTMLInputElement>('[data-cu-time-input]');
  const error = document.querySelector<HTMLElement>('[data-cu-time-error]');
  const result = document.querySelector<HTMLElement>('[data-cu-time-result]');
  const resultInput = document.querySelector<HTMLElement>('[data-cu-time-result-input]');
  const resultGregorian = document.querySelector<HTMLElement>('[data-cu-time-result-gregorian]');

  if (form && input && error && result && resultInput && resultGregorian) {
    const clearError = () => {
      error.hidden = true;
      error.textContent = '';
      input.setAttribute('aria-invalid', 'false');
    };

    input.addEventListener('input', clearError);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearError();

      const converted = convertCuTimeForDisplay(input.value);
      if (!converted.ok) {
        input.setAttribute('aria-invalid', 'true');
        error.textContent = converted.error.message;
        error.hidden = false;
        result.hidden = true;
        input.focus();
        return;
      }

      resultInput.textContent = converted.value.inputCuTime;
      resultGregorian.textContent = converted.value.gregorianUtc;
      result.hidden = false;
      result.focus();
    });
  }
</script>

<style>
  .cu-time-converter {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding: var(--space-8);
    border: 1px solid var(--color-translucent-blue);
    background: var(--color-surface-translucent);
  }

  .cu-time-converter__header,
  .cu-time-direction,
  .cu-time-form,
  .cu-time-form__field,
  .cu-time-result,
  .cu-time-result dl {
    display: grid;
    gap: var(--space-4);
  }

  .cu-time-converter__eyebrow,
  .cu-time-converter__intro,
  .cu-time-converter__methodology,
  .cu-time-form__hint,
  .cu-time-form__error,
  .cu-time-result h3,
  .cu-time-result dl,
  .cu-time-result dd {
    margin: 0;
  }

  .cu-time-converter__eyebrow {
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2,
  h3 {
    color: var(--color-white-gold);
    font-family: var(--font-family-serif);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  h3 {
    font-size: 1.35rem;
  }

  .cu-time-converter__intro,
  .cu-time-converter__methodology,
  .cu-time-form {
    max-width: var(--measure-readable);
  }

  .cu-time-form label,
  .cu-time-form legend,
  .cu-time-result dt {
    color: var(--color-white-gold);
    font-weight: 700;
  }

  .cu-time-form__hint,
  .cu-time-converter__methodology {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .cu-time-form fieldset {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cu-time-form__date-grid,
  .cu-time-form__time-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .cu-time-form__date-grid {
    grid-template-columns: minmax(5rem, 0.7fr) minmax(5rem, 0.7fr) minmax(10rem, 1.6fr) minmax(5rem, 0.7fr);
  }

  .cu-time-form input,
  .cu-time-form select {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-translucent-blue);
    border-radius: 0;
    background: var(--color-background);
    color: var(--color-text);
    font: inherit;
  }

  .cu-time-form input:focus-visible,
  .cu-time-form select:focus-visible,
  .cu-time-form button:focus-visible,
  .cu-time-result:focus-visible {
    outline: 3px solid var(--color-cyan);
    outline-offset: 3px;
  }

  .cu-time-form input[aria-invalid='true'] {
    border-color: var(--color-amber);
  }

  .cu-time-form select[aria-invalid='true'] {
    border-color: var(--color-amber);
  }

  .cu-time-form__error {
    color: var(--color-amber);
    font-weight: 600;
  }

  .cu-time-form button {
    width: fit-content;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-cyan);
    background: transparent;
    color: var(--color-cyan);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .cu-time-form button:hover {
    background: var(--color-translucent-blue);
  }

  .cu-time-result {
    padding: var(--space-6);
    border-left: 3px solid var(--color-cyan);
    background: var(--color-background);
  }

  .cu-time-result dl > div {
    display: grid;
    gap: var(--space-2);
  }

  .cu-time-result dd {
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  [hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cu-time-form button {
      transition: none;
    }
  }

  @media (max-width: 42rem) {
    .cu-time-form__date-grid,
    .cu-time-form__time-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cu-time-form__field--year {
      grid-column: 1 / -1;
    }
  }
</style>
