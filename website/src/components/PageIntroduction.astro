---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-introduction" aria-labelledby="page-title">
  <div class="page-introduction__inner">
    <p class="page-introduction__eyebrow">{eyebrow}</p>
    <h1 id="page-title">{title}</h1>
    <p class="page-introduction__description">{description}</p>
    <div class="page-introduction__content">
      <slot />
    </div>
  </div>
</section>

<style>
  .page-introduction {
    padding-block: clamp(var(--space-12), 8vw, 7rem);
  }

  .page-introduction__inner {
    width: min(100% - (2 * var(--space-6)), 72rem);
    margin-inline: auto;
  }

  .page-introduction__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-amber);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-white-gold);
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .page-introduction__description {
    margin-block: var(--space-6) 0;
    color: var(--color-text);
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
  }

  .page-introduction__content {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-translucent-blue);
  }

  @media (max-width: 36rem) {
    .page-introduction__inner {
      width: min(100% - (2 * var(--space-4)), 72rem);
    }
  }
</style>
