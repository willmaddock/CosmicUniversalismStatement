---
interface Props {
  id: string;
  title: string;
  variant?: 'plain' | 'panel' | 'notice' | 'card';
}

const {
  id,
  title,
  variant = 'plain',
} = Astro.props;
const titleId = `${id}-title`;
const hasContext = Astro.slots.has('context');
---

<section
  id={id}
  class:list={['content-section', `content-section--${variant}`]}
  aria-labelledby={titleId}
>
  {
    hasContext && (
      <div class="content-section__context">
        <slot name="context" />
      </div>
    )
  }
  <h2 id={titleId}>{title}</h2>
  <div class="content-section__body">
    <slot />
  </div>
</section>

<style>
  .content-section {
    max-width: var(--measure-readable);
    scroll-margin-top: var(--space-6);
  }

  .content-section--panel,
  .content-section--notice,
  .content-section--card {
    padding: var(--space-8);
    background: var(--color-surface-translucent);
  }

  .content-section--panel,
  .content-section--card {
    border: 1px solid var(--color-translucent-blue);
  }

  .content-section--notice {
    border-left: 0.25rem solid var(--color-amber);
  }

  .content-section--card {
    max-width: none;
    padding: var(--space-6);
  }

  .content-section__context {
    display: flex;
    margin-bottom: var(--space-4);
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .content-section--card h2 {
    font-size: 1.375rem;
  }

  .content-section__body {
    margin-top: var(--space-4);
  }

  .content-section__body :global(p) {
    margin: 0;
  }

  .content-section__body :global(p + p) {
    margin-top: var(--space-4);
  }

  @media (max-width: 36rem) {
    .content-section--panel,
    .content-section--notice {
      padding: var(--space-6);
    }

    .content-section--card {
      padding: var(--space-4);
    }
  }
</style>
