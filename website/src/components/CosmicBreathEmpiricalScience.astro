---
import { cosmicBreathEmpiricalSources } from '../data/cosmic-breath/cosmic-breath-empirical-sources';

const sourceReturnTargets: Readonly<Record<number, string>> = {
  1: 'science-citation-1',
  2: 'science-citation-2',
  3: 'science-citation-3',
  4: 'science-citation-4',
  5: 'science-citation-5',
  6: 'science-citation-6',
  7: 'science-citation-7',
  8: 'science-citation-8',
  9: 'science-citation-9',
  10: 'science-citation-10',
  11: 'science-citation-11',
  12: 'science-citation-12',
  13: 'science-citation-13',
  14: 'science-citation-14',
  15: 'science-citation-15',
  16: 'science-citation-16',
  17: 'science-citation-17',
  18: 'science-citation-18',
  19: 'science-citation-19',
};
---

<section
  class="breath-empirical"
  id="cosmic-breath-empirical-context"
  aria-labelledby="breath-empirical-title"
>
  <header class="breath-empirical__intro">
    <p class="eyebrow">Primary-source empirical context</p>
    <h2 id="breath-empirical-title">Empirical Science and Cosmic Universalism</h2>
    <p>
      This research layer separates observation, model-dependent inference, theoretical
      research, open questions, and CU propositions. Scientific citations provide context;
      they do not validate the complete Cosmic Breath chronology.
    </p>

  </header>

  <div class="empirical-grid empirical-grid--paired">
    <section
      class="empirical-card empirical-card--observation"
      id="empirical-observations"
      aria-labelledby="empirical-observations-title"
    >
      <p class="classification">Observation</p>
      <h3 id="empirical-observations-title">What Observations Establish</h3>
      <p>
        Observations of distant supernovae and other cosmological probes support the
        conclusion that cosmic expansion is accelerating.
        <sup id="science-citation-1"
          ><a href="#science-source-1" aria-label="See scientific source 1">[1]</a></sup
        ><sup id="science-citation-2"
          ><a href="#science-source-2" aria-label="See scientific source 2">[2]</a></sup
        >
      </p>
      <p>
        The universe is approximately 13.8 billion years old under the standard
        cosmological model.<sup id="science-citation-3"
          ><a href="#science-source-3" aria-label="See scientific source 3">[3]</a></sup
        >
      </p>
      <p>
        The observable universe is roughly 92 billion light-years across in present
        comoving-distance terms. This is not the known size of the entire universe and is
        not interchangeable with its age.<sup id="science-citation-19"
          ><a href="#science-source-19" aria-label="See scientific source 19">[19]</a></sup
        >
      </p>
      <dl class="concept-pairs">
        <div>
          <dt>Cosmic age</dt>
          <dd>Elapsed cosmic time since the hot early universe.</dd>
        </div>
        <div>
          <dt>Comoving distance</dt>
          <dd>Present separation after accounting for the expansion of space.</dd>
        </div>
      </dl>
      <p class="boundary-note">
        The observable region may be smaller than the whole universe. Neither its age nor
        its comoving extent defines the placement or scale of the CU Observable Universe
        marker.
      </p>
    </section>

    <section
      class="empirical-card empirical-card--inference"
      id="empirical-open-questions"
      aria-labelledby="empirical-open-questions-title"
    >
      <p class="classification">Open question</p>
      <h3 id="empirical-open-questions-title">What Remains Unknown</h3>
      <p>
        Dark energy is the name used for the still-unknown cause or model component
        associated with accelerated expansion.
        <sup id="science-citation-5"
          ><a href="#science-source-5" aria-label="See scientific source 5">[5]</a></sup
        ><sup id="science-citation-6"
          ><a href="#science-source-6" aria-label="See scientific source 6">[6]</a></sup
        >
      </p>
      <p>
        A cosmological constant remains a standard baseline interpretation. Dynamical
        fields and modified gravity are studied alternatives, and current observations
        have not established a unique physical identity.
      </p>
      <aside class="evolving-evidence" aria-labelledby="evolving-evidence-title">
        <p class="classification">Model-dependent inference</p>
        <h4 id="evolving-evidence-title">Evolving evidence</h4>
        <p>
          DESI’s current results provide model- and dataset-dependent hints that dark
          energy may evolve, but they do not establish that conclusion.<sup
            id="science-citation-4"
            ><a href="#science-source-4" aria-label="See scientific source 4">[4]</a></sup
          >
        </p>
      </aside>
      <p class="boundary-note">
        DESI is not evidence for CU Dark Energy, CU Anti-Dark Energy, compression, a
        complete Cosmic Breath, or a future universal reset.
      </p>
    </section>
  </div>

  <section
    class="empirical-card empirical-card--wide empirical-card--theory"
    id="scientific-cosmic-futures"
    aria-labelledby="scientific-cosmic-futures-title"
  >
    <p class="classification">Theoretical research</p>
    <h3 id="scientific-cosmic-futures-title">Scientific Models of the Far Future</h3>
    <p>
      Future cosmic behavior depends on the underlying physics and the model used to
      extrapolate far beyond the observed era. Continued expansion and
      heat-death-like outcomes are conditional possibilities.
    </p>
    <p>
      Heat death is one conditional long-term scenario, not a directly observed or
      inevitable future event.<sup id="science-citation-14"
        ><a href="#science-source-14" aria-label="See scientific source 14">[14]</a></sup
      >
    </p>
    <p>
      Contraction, recollapse, bounce, and cyclic cosmologies can be studied
      mathematically.<sup id="science-citation-7"
        ><a href="#science-source-7" aria-label="See scientific source 7">[7]</a></sup
      ><sup id="science-citation-8"
        ><a href="#science-source-8" aria-label="See scientific source 8">[8]</a></sup
      >
      These papers demonstrate possibilities within particular constructions, not
      empirical confirmation that our universe will contract or that CU is correct.
    </p>
    <aside class="cu-boundary-inline" aria-label="CU proposition">
      <p class="classification">CU proposition</p>
      <p>
        CU-defined Anti-Dark Energy is an internal CU proposition. No standard observed
        scientific component equivalent to CU Anti-Dark Energy was identified in the
        reviewed authoritative literature.
      </p>
      <p>
        It is not equated here with a negative cosmological constant, phantom energy,
        scalar fields, modified gravity, recollapse, or any cited cyclic model.
      </p>
    </aside>
  </section>

  <section
    class="empirical-card empirical-card--wide"
    id="scientific-units-notation"
    aria-labelledby="scientific-units-notation-title"
  >
    <p class="classification">Scientific standard and mathematical definition</p>
    <h3 id="scientific-units-notation-title">Units, Scales, and Mathematical Notation</h3>
    <div class="units-grid">
      <article>
        <p class="card-label">A · Scientific standard</p>
        <h4>The SI second</h4>
        <p>
          The SI second is defined by fixing the cesium-133 unperturbed ground-state
          hyperfine-transition frequency at exactly 9,192,631,770 hertz.<sup
            id="science-citation-9"
            ><a href="#science-source-9" aria-label="See scientific source 9">[9]</a></sup
          >
        </p>
        <p>This defines a measurement unit, not a smallest physical interval.</p>
      </article>
      <article>
        <p class="card-label">B · Derived natural unit</p>
        <h4>Planck time</h4>
        <p class="equation">5.391247(60) × 10⁻⁴⁴ seconds</p>
        <p>
          Planck time is approximately 5.391247(60) × 10⁻⁴⁴ seconds and is a derived
          natural unit—not an experimentally proven smallest interval.<sup
            id="science-citation-10"
            ><a href="#science-source-10" aria-label="See scientific source 10">[10]</a></sup
          >
        </p>
        <p><strong>CU ATOM is not identified with Planck time.</strong></p>
      </article>
      <article>
        <p class="card-label">C · Mathematical notation</p>
        <h4>Tetration</h4>
        <p class="equation">2↑↑n</p>
        <p>
          In the convention used here, 2↑↑n denotes a right-associated power tower of 2s
          with height n. The expression has no inherent unit of time.<sup
            id="science-citation-11"
            ><a href="#science-source-11" aria-label="See scientific source 11">[11]</a></sup
          >
        </p>
        <p>
          A model must assign units and physical interpretation separately. The full
          value of 2↑↑65,536 is not calculated on this page.
        </p>
      </article>
    </div>
  </section>

  <section
    class="empirical-card empirical-card--wide empirical-card--theory"
    id="quantum-holography-information"
    aria-labelledby="quantum-holography-information-title"
  >
    <p class="classification">Theoretical research</p>
    <h3 id="quantum-holography-information-title">
      Quantum Gravity, Holography, and Information
    </h3>
    <div class="research-grid">
      <article>
        <h4>Quantum foam</h4>
        <p>
          Quantum foam is a theoretical description associated with possible
          Planck-scale fluctuations in geometry.<sup id="science-citation-12"
            ><a href="#science-source-12" aria-label="See scientific source 12">[12]</a></sup
          >
          Observations constrain some proposed effects, but quantum foam has not been
          directly detected as a universal chronological stage.<sup id="science-citation-13"
            ><a href="#science-source-13" aria-label="See scientific source 13">[13]</a></sup
          >
        </p>
      </article>
      <article>
        <h4>Holography</h4>
        <p>
          Holography is a major theoretical idea in gravitational physics, and concrete
          dualities exist in specific theoretical settings.<sup id="science-citation-15"
            ><a href="#science-source-15" aria-label="See scientific source 15">[15]</a></sup
          ><sup id="science-citation-16"
            ><a href="#science-source-16" aria-label="See scientific source 16">[16]</a></sup
          >
          This does not establish that the observed universe is literally a hologram or
          that consciousness is holographic.
        </p>
      </article>
      <article>
        <h4>Black holes</h4>
        <p>
          Hawking radiation and evaporation arise from theoretical calculations, and
          astrophysical Hawking radiation has not been directly detected.<sup
            id="science-citation-17"
            ><a href="#science-source-17" aria-label="See scientific source 17">[17]</a></sup
          >
          Evaporation time depends strongly on mass, spin, particle content, accretion,
          and environment; there is no universal scientific “black-hole age.”<sup
            id="science-citation-18"
            ><a href="#science-source-18" aria-label="See scientific source 18">[18]</a></sup
          >
        </p>
      </article>
    </div>
    <p class="memory-boundary">
      Holography, black-hole information research, and cyclic cosmological models do not
      currently establish semantic memory, civilization records, consciousness, or
      ethical learning surviving between cosmic cycles.
    </p>
    <p>
      Memory transfer, Human/civilization memory condensation, Final memory imprint,
      Consciousness holography, and cross-cycle ethical inheritance remain CU-defined
      concepts.
    </p>
  </section>

  <section
    class="empirical-card empirical-card--wide empirical-card--cu"
    id="where-cu-begins"
    aria-labelledby="where-cu-begins-title"
  >
    <p class="classification">CU proposition</p>
    <h3 id="where-cu-begins-title">Where CU Begins</h3>
    <div class="boundary-columns">
      <div>
        <h4>Empirical sources support or define</h4>
        <ul>
          <li>accelerated expansion;</li>
          <li>an approximately 13.8-billion-year model age;</li>
          <li>observable-universe distance terminology;</li>
          <li>the SI second and Planck time as a derived natural unit;</li>
          <li>mathematical definitions and active scientific research.</li>
        </ul>
      </div>
      <div>
        <h4>Those sources do not establish</h4>
        <ul>
          <li>the 51-state TOM chronology or individual TOM duration assignments;</li>
          <li>the declared 3.108-trillion-year Cosmic Breath as an empirical cycle;</li>
          <li>CU Dark Energy as the identified cause of acceleration;</li>
          <li>CU-defined Anti-Dark Energy as an observed force;</li>
          <li>a future CU compression phase, ZTOM reset, or cross-cycle memory;</li>
          <li>CU ATOM as Planck time.</li>
        </ul>
      </div>
    </div>
    <p class="cu-statement">
      Cosmic Universalism uses empirical science as a point of comparison, while the
      complete Cosmic Breath remains a CU theoretical proposition.
    </p>
    <p>
      Any continuity or memory across Cosmic Breaths is a CU proposition, not a
      conclusion currently established by physics.
    </p>
  </section>

  <section
    class="empirical-card empirical-card--wide empirical-card--sources"
    id="scientific-sources"
    aria-labelledby="scientific-sources-title"
  >
    <p class="classification">Sources and scope</p>
    <h3 id="scientific-sources-title">Sources and Scientific Boundaries</h3>
    <p>
      Each entry identifies what kind of authority it provides and a limitation relevant
      to this page. The citations support only the nearby empirical or scientific
      statement.
    </p>
    <ol class="source-list">
      {
        cosmicBreathEmpiricalSources.map((source) => (
          <li id={`science-source-${source.id}`}>
            <div class="source-heading">
              <span class="source-number" aria-hidden="true">
                {source.id}
              </span>
              <span class="source-class">{source.sourceClass}</span>
            </div>
            <p class="source-citation">
              <strong>{source.authors}.</strong> “{source.title}.”{' '}
              <cite>{source.organization}</cite>, {source.year}.
            </p>
            <p class="source-links">
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.identifier ?? `Official ${source.organization} source`}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
              <a
                class="citation-return"
                href={`#${sourceReturnTargets[source.id]}`}
                aria-label={`Return to citation ${source.id}`}
              >
                Return to citation
              </a>
            </p>
            <p class="source-limitation">
              <span>Scope note:</span> {source.limitation}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <nav class="group-continuation" aria-label="Primary-Source Empirical Context continuation">
    <a href="#cosmic-breath-page-guide">Back to page guide</a>
    <a href="#cosmic-breath-page-top">Back to top</a>
  </nav>
</section>

<style>
  .breath-empirical {
    --panel: rgba(6, 22, 39, 0.84);
    --line: rgba(128, 211, 249, 0.22);
    --muted: rgba(207, 226, 239, 0.82);
    --cyan: #8bdcff;
    --blue: #a9c8ff;
    --gold: #ffd18a;
    width: min(112rem, calc(100vw - clamp(2rem, 6vw, 6rem)));
    margin: clamp(2rem, 5vw, 4rem) 0 0 50%;
    padding: clamp(1.5rem, 4vw, 4rem);
    transform: translateX(-50%);
    color: rgba(244, 250, 255, 0.96);
    border: 1px solid var(--line);
    border-radius: clamp(1.25rem, 3vw, 2.5rem);
    background:
      radial-gradient(circle at 12% 2%, rgba(31, 173, 224, 0.14), transparent 34rem),
      radial-gradient(circle at 90% 22%, rgba(101, 139, 210, 0.1), transparent 32rem),
      linear-gradient(145deg, rgba(2, 14, 27, 0.99), rgba(6, 23, 39, 0.98));
    box-shadow: 0 2.5rem 6rem rgba(0, 5, 16, 0.3);
    scroll-margin-top: 2rem;
  }

  .breath-empirical__intro {
    max-width: 74rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .eyebrow,
  .classification,
  .card-label {
    margin: 0;
    color: var(--cyan);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .breath-empirical__intro h2 {
    margin: 0.55rem 0 1rem;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .breath-empirical__intro > p:last-of-type {
    max-width: 57rem;
    margin: 0 auto;
    color: var(--muted);
    font-size: clamp(1rem, 1.8vw, 1.16rem);
    line-height: 1.75;
  }

  .breath-empirical sup a:focus-visible,
  .source-list a:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  .empirical-grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    max-width: 96rem;
    margin: 0 auto clamp(1rem, 2.5vw, 2rem);
  }

  .empirical-grid--paired {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .empirical-card {
    min-width: 0;
    scroll-margin-top: 2rem;
    padding: clamp(1.4rem, 3vw, 2.6rem);
    border: 1px solid var(--line);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background:
      linear-gradient(145deg, rgba(20, 59, 87, 0.2), transparent 55%),
      var(--panel);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .empirical-card--wide {
    max-width: 96rem;
    margin: 0 auto clamp(1rem, 2.5vw, 2rem);
  }

  .empirical-card--observation {
    border-top-color: rgba(96, 217, 255, 0.7);
  }

  .empirical-card--inference,
  .empirical-card--theory {
    border-top-color: rgba(156, 187, 255, 0.58);
  }

  .empirical-card--inference .classification,
  .empirical-card--theory .classification {
    color: var(--blue);
  }

  .empirical-card--cu {
    border-color: rgba(255, 202, 115, 0.36);
    background:
      linear-gradient(145deg, rgba(106, 70, 17, 0.2), transparent 60%),
      rgba(18, 23, 31, 0.92);
  }

  .empirical-card--cu .classification,
  .cu-boundary-inline .classification {
    color: var(--gold);
  }

  .empirical-card h3 {
    margin: 0.35rem 0 1.2rem;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .empirical-card h4 {
    margin: 0.35rem 0 0;
    color: #fff;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .empirical-card > p,
  .empirical-card li,
  .empirical-card dd,
  .units-grid p,
  .research-grid p,
  .boundary-columns p {
    color: var(--muted);
    line-height: 1.72;
  }

  .empirical-card > p {
    margin: 1rem 0 0;
  }

  .empirical-card sup {
    margin-left: 0.16rem;
    font-size: 0.72em;
    line-height: 0;
  }

  .empirical-card sup + sup {
    margin-left: 0.08rem;
  }

  .empirical-card sup a {
    display: inline-block;
    padding: 0.08rem 0.14rem;
    color: #bdeaff;
    font-weight: 750;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.14em;
  }

  .concept-pairs,
  .units-grid,
  .research-grid,
  .boundary-columns {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .concept-pairs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .concept-pairs > div,
  .units-grid article,
  .research-grid article,
  .boundary-columns > div {
    min-width: 0;
    padding: 1.1rem;
    border: 1px solid rgba(128, 211, 249, 0.16);
    border-radius: 0.9rem;
    background: rgba(3, 15, 29, 0.6);
  }

  .concept-pairs dt {
    color: #fff;
    font-weight: 700;
  }

  .concept-pairs dd {
    margin: 0.4rem 0 0;
  }

  .boundary-note,
  .memory-boundary,
  .cu-statement {
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--cyan);
    border-radius: 0 0.65rem 0.65rem 0;
    background: rgba(60, 154, 207, 0.1);
  }

  .evolving-evidence,
  .cu-boundary-inline {
    margin-top: 1.25rem;
    padding: 1.1rem;
    border: 1px solid rgba(159, 188, 255, 0.28);
    border-radius: 0.9rem;
    background: rgba(55, 76, 127, 0.16);
  }

  .evolving-evidence p:last-child,
  .cu-boundary-inline p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    line-height: 1.72;
  }

  .cu-boundary-inline {
    border-color: rgba(255, 202, 115, 0.3);
    background: rgba(83, 51, 12, 0.2);
  }

  .units-grid,
  .research-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .units-grid p,
  .research-grid p {
    margin: 0.7rem 0 0;
  }

  .equation {
    color: #fff !important;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .memory-boundary {
    margin-top: 1.25rem !important;
    border-left-color: var(--blue);
  }

  .boundary-columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .boundary-columns ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.8rem 0 0;
    padding-left: 1.2rem;
  }

  .cu-statement {
    border-left-color: var(--gold);
    background: rgba(83, 51, 12, 0.22);
    color: rgba(250, 244, 232, 0.94) !important;
    font-weight: 650;
  }

  .empirical-card--sources {
    margin-bottom: 0;
  }

  .source-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-list > li {
    max-width: none;
    min-width: 0;
    scroll-margin-top: 2rem;
    padding: 1.15rem;
    border: 1px solid rgba(128, 211, 249, 0.16);
    border-radius: 0.9rem;
    background: rgba(3, 15, 29, 0.62);
  }

  .source-list > li:last-child {
    grid-column: 1 / -1;
  }

  .source-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  .source-number {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 750;
    border: 1px solid rgba(128, 211, 249, 0.3);
    border-radius: 50%;
  }

  .source-class {
    display: inline-flex;
    padding: 0.35rem 0.55rem;
    color: #d7f2ff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid rgba(128, 211, 249, 0.22);
    border-radius: 999px;
    background: rgba(31, 91, 128, 0.28);
  }

  .source-citation,
  .source-links,
  .source-limitation {
    margin: 0.7rem 0 0;
    overflow-wrap: anywhere;
  }

  .source-citation strong {
    color: #fff;
  }

  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
  }

  .source-list a {
    color: #9de1ff;
    font-weight: 650;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.16em;
  }

  .citation-return {
    color: #c8d9e5 !important;
    font-size: 0.82rem;
  }

  .source-limitation {
    color: rgba(195, 216, 230, 0.78) !important;
    font-size: 0.9rem;
  }

  .source-limitation span {
    color: #fff;
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
